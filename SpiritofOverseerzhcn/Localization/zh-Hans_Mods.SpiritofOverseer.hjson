Configs: {
	ReworkConfig: {
		DisplayName: 视觉设置

		flash: {
			Label: 闪光强度
			Tooltip: 设置闪光的明暗度
		}

		overlay: {
			Label: 覆盖强度
			Tooltip: 设置屏幕覆盖强弱度
		}

		seizures: {
			Label: 光敏警告提示
			Tooltip: 启动世界后有光敏警告提示
		}

		bossRenames: {
			Label: BOSS名称重命名
			Tooltip: ""
		}
	}

	CompatConfig: {
		DisplayName: 模组兼容性设置

		healthScale: {
			Label: 生命值增加
			Tooltip: 让魂灵BOSS的生命值乘以当前数值
		}

		damageScale: {
			Label: 伤害增加
			Tooltip: 让魂灵BOSS的攻击伤害乘以当前数值
		}

		speedScale: {
			Label: 速度加成
			Tooltip:
				'''
				让魂灵BOSS的速度乘以当前数值
				有更高的目标挑战BOSS推荐2倍速度
				灾厄炼狱模组推荐使用1.35倍速度
				'''
		}

		extraItems: {
			Label: 额外物品
			Tooltip:
				'''
				(可选)
				在这个模组增加一些不相关的物品
				'''
		}

		extraPotions: {
			Label: 额外药剂内容
			Tooltip:
				'''
				(可选)
				增加与魂灵的职业有关的增益药水
				'''
		}

		extraPrefixes: {
			Label: 额外修饰语内容
			Tooltip:
				'''
				(可选)
				增加与魂灵的职业有关的修饰语
				'''
		}

		masterDrops: {
			Label: 大师模式掉落
			Tooltip:
				'''
				(推荐!)
				让魂灵模组的boss的大师掉落武器，在复仇模式或永恒模式也可以掉落
				'''
		}

		masterDropsAreNonExclusive: {
			Label: 专家模式下掉落大师模式专属武器
			Tooltip:
				'''
				专家模式下掉落大师模式专属武器
				如果你不喜欢玩大师或其他其他模组只能在专家模式下游玩
				(例如：fargo魂模组永恒模式在大师模式下变成受虐模式，或者灾厄炼狱模组无法开启大师模式)
				'''
		}

		itemReworks: {
			Label: 重置原魂灵一些武器
			Tooltip:
				'''
				(推荐!)
				让原魂灵模组武器更好的使用
				'''
		}

		spiramityBR: {
			Label: 魂灵BOSS加入灾厄bossrush
			Tooltip: 魂灵BOSS加入灾厄bossrush，根据适当的阶级排序
		}

		defenseDamage: {
			Label: 防御伤害支持
			Tooltip: 若启用灾厄模组某些魂灵BOSS攻击会造成防御伤害
		}

		eternityModeOnly: {
			Label: 仅限永恒模式
			Tooltip: 模组中BOSS的重制内容仅在永恒模式开启时生效
		}
	}

	ReworkTogglesConfig: {
		DisplayName: BOSS重置开/关

		dusking: {
			Label: "[i:SpiritMod/DuskingMask]薄暮焱魂"
			Tooltip: 薄暮焱魂重置
		}

		atlas: {
			Label: "[i:SpiritMod/AtlasMask]擎元魔像"
			Tooltip: 擎元魔像重置
		}
	}
}
