ItemDescriptions: {
	DuskPendant:
		'''
		远程攻击和魔法攻击可能会释放追踪目标的暗影火球
		在夜晚，暗影火球释放频率更高
		'''
	ShadowflameSword:
		'''
		挥动武器时会释放出一连串的暗影火焰束，所造成的伤害仅为剑刃伤害的一小部分
		受到暗影火焰伤害的敌人有概率使其发生爆炸
		'''
	ShadowSphere: 召唤出一个影焰圆环符文，该符文会释放暗影焰追踪敌人。
	UmbraStaff: 发射出一连串的暗影骷髅
}

