ItemDescriptions: {
	BloodButcherer: 被击中敌人会叠加出血效果
	DemonBow: 将木箭转化为邪箭
	LightsBane: 挥砍时释放黑暗斩切
	TendonBow: 将木箭转化为韧带箭
	TheRottedFork: 戳刺时在矛尖产生猩红斩痕
	TheUndertaker: 射击时释放震荡波
}

Items: {
	ArmorMeltingArrow: {
		DisplayName: 穿甲箭
		Tooltip:
			'''
			无视少量防御
			命中时施加灵液减益，降低敌人的防御
			'''
	}

	DevilsRifle: {
		DisplayName: 恶魔步枪
		Tooltip: 射击时释放暗影焰触手
	}

	DiggerofHoles: {
		DisplayName: 掘洞怪
		Tooltip:
			'''
			能够开采狱石
			"带个硬核的R"
			'''
	}

	GemChewer: {
		DisplayName: 噬晶者
		Tooltip:
			'''
			能够开采狱石
			"你不该吃宝贵的矿物的，那会害死你的"
			'''
	}

	LigamentArrow: {
		DisplayName: 韧带箭
		Tooltip: 无视少量防御
	}

	SpoonfulofDarkness: {
		DisplayName: 黑暗一匙
		Tooltip: 挥舞时在汤匙末端产生伤害尾迹
	}

	WormbaneArrow: {
		DisplayName: 戮虫箭
		Tooltip:
			'''
			无限穿透
			命中时施加诅咒狱火
			'''
	}
}

Projectiles: {
	ArmorMeltingArrow.DisplayName: 穿甲箭
	BrainofCthulhu.DisplayName: "{$NPCName.BrainofCthulhu}"
	DevilsRifle.DisplayName: 恶魔步枪
	DiggerofHoles.DisplayName: 掘洞怪
	GemChewer.DisplayName: 噬晶者
	LigamentArrow.DisplayName: 韧带箭
	SpoonfulofDarkness.DisplayName: 黑暗一匙
	TheUndertaker.DisplayName: 夺命枪
	WormbaneArrow.DisplayName: 戮虫箭
}

Configs: {
	ReworkConfig: {
		DisplayName: 重置配置

		eow: {
			Label: 世界吞噬怪重置
			Tooltip: ""
		}

		boc: {
			Label: 克苏鲁之脑重置
			Tooltip: ""
		}

		devilsrifle: {
			Label: 恶魔步枪
			Tooltip:
				'''
				添加恶魔步枪，替换暗影珠奖池中的火枪
				将火枪移入军火商的商店
				'''
		}

		darkspoon: {
			Label: 黑暗一匙
			Tooltip:
				'''
				添加黑暗一匙，与猩红之地的腐叉相对应
				调整腐叉的数值与暗黑一匙对应
				'''
		}

		ligamentarrow: {
			Label: 韧带箭
			Tooltip:
				'''
				添加韧带箭，与腐化之地的邪箭相对应
				修改了掉落邪箭的奖池
				'''
		}

		evildrills: {
			Label: 邪恶矿钻头
			Tooltip: 添加掘洞怪与噬晶者，作为与邪恶矿镐对应的钻头
		}

		evilbows: {
			Label: 邪恶矿弓平衡调整
			Tooltip:
				'''
				略微调整了恶魔弓与肌腱弓的数值
				也给它们添加了转化木箭的能力
				'''
		}

		evilswords: {
			Label: 邪恶矿剑平衡调整
			Tooltip: 略微调整了魔光剑与血型屠刀的数值
		}

		mobs: {
			Label: 邪恶生物群系敌人重置
			Tooltip:
				'''
				当前仅重置以下内容:
				-猩红喀迈拉
				-噬魂怪
				-腐化者
				-灵液黏黏怪
				此设置还会切换邪恶生物群系敌怪的属性变化
				'''
		}
	}
}

