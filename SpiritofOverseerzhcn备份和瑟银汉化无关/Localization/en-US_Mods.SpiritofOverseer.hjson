ItemDescriptions: {
	DuskPendant:
		'''
		Ranged and magic attacks are occasionally accompanied by a homing shadow fireball
		Shadow fireballs are shot more frequently at night
		'''
	ShadowflameSword:
		'''
		Creates a barrage of shadowflame beams on swing that deal a fraction of the blade's damage
		Dealing direct damage to enemies afflicted with shadowflame has a chance to make them explode
		'''
	ShadowSphere: Summons a shadowflame circle rune that unleahes antumbral flames to chase after enemies
	UmbraStaff: Shoots a barrage of antumbral skulls
}

Projectiles: {
	AntumbralFlame.DisplayName: Antumbral Flame
	AntumbralFlameF.DisplayName: Antumbral Flame
	AntumbralSkull.DisplayName: Antumbral Skull
	AntumbralSkullF.DisplayName: Antumbral Skull
	DuskBeam.DisplayName: Dusk Beam
	ShadowflameSword.DisplayName: Shadowflame Sword
	ShadowPulseWave.DisplayName: Shadow Pulse Wave
	VisualShockwave.DisplayName: Visual Shockwave
	PrismaticFlame.DisplayName: Prismatic Flame
}

