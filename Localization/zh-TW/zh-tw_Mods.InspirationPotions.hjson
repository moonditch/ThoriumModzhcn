Buffs: {
	InspirationWeakness: {
		DisplayName: 藝術瓶頸
		Description: 減少{0}%音波傷害
	}
}

Items: {
	InspirationFlower: {
		DisplayName: 靈感簧舌
		Tooltip:
			'''
			增加8%的音波傷害
			需要時自動使用靈感藥水
			'''
	}

	LesserInspirationPotion.DisplayName: 弱效靈感藥水
	InspirationPotion.DisplayName: 靈感藥水
	GreaterInspirationPotion.DisplayName: 強效靈感藥水
	SuperInspirationPotion.DisplayName: 超級靈感藥水
	SupremeInspirationPotion.DisplayName: 至尊靈感藥水
	DecorativeGreaterInspirationPotion.DisplayName: 裝飾用強效靈感藥水
	DecorativeInspirationPotion.DisplayName: 裝飾用靈感藥水
	DecorativeLesserInspirationPotion.DisplayName: 裝飾用弱效靈感藥水
	DecorativeSuperInspirationPotion.DisplayName: 裝飾用超級靈感藥水
	DecorativeSupremeInspirationPotion.DisplayName: 裝飾用至尊靈感藥水
}

PotionTooltip: 恢復 {0} 靈感值
Keybinds.QuickInspiration.DisplayName: 快速靈感


Configs: {
	InspirationPotionsConfig: {
		DisplayName: 共享設置

		CrateDrops: {
			Label: 寶匣掉落
			Tooltip: 讓該模組影響到的釣魚寶匣的掉落
		}
	}

	InspirationPotionsClientConfig: {
		DisplayName: 客戶端設置

		DungeonBottles: {
			Label: 地牢藥瓶
			Tooltip: 是否將靈感藥水在世界的生成過程中，在地牢生成
		}
	}

	CrateLoot: {
		Tooltip: 箱子中的戰利品

		Mixed: {
			Label: 融合
			Tooltip:
				'''
				靈感值藥水和其他藥水獲取概率相同
				嚴格來說，這會降低其他掉落物出現的概率，因爲它們被增加到了同一種權重。
				'''
		}

		Separate: {
			Label: 分離
			Tooltip: 靈感藥水有的概率（1/8）從箱子中獲取，其他藥水的掉落保持不變。
		}

		None: {
			Label: 刪除
			Tooltip: 靈感藥水不可以在箱子獲取
		}
	}
}

