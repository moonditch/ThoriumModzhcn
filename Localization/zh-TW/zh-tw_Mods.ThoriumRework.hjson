Items: {
	BandofCratons: {
		DisplayName: "{$Mods.ThoriumRework.Items.BandofCratonsCosmetic.DisplayName}"
		Tooltip:
			'''
			免疫能量超載，且使你的攻擊施加能量超載
			獲得40點生命護盾
			失去護盾時，根據失去的量回復玩家的資源
			一次性失去超過20點護盾時，會製造電磁爆炸摧毀附近的3個彈幕
			{$Mods.ThoriumRework.Items.BandofCratonsCosmetic.Tooltip}
			'''
	}

	BandofCratonsCosmetic: {
		DisplayName: 古陸核之帶
		Tooltip: '''"非常耐用，甚至能承受大陸漂移的偉力"'''
	}

	BannerofWar: {
		DisplayName: "{$Mods.ThoriumRework.Items.BannerofWarCosmetic.DisplayName}"
		Tooltip:
			'''
			戰鬥中，你的傷害與額外治療量會隨時間增加
			這些增益在你脫戰後會逐漸減少
			戰鬥中會不斷釋放治療脈衝，回復隊友等同于額外治療量的生命
			脈衝的頻率會隨著戰鬥時間增加
			咒音增幅範圍也會影響治療脈衝的範圍
			'''
	}

	BannerofWarCosmetic: {
		DisplayName: 戰爭之旗
		Tooltip: ""
	}

	BeholderBlade: {
		DisplayName: 凝視者之刃
		Tooltip:
			'''
			每揮舞的第三和四次會發射凝視光束
			暴擊時，敵人身上會產生虛空泡泡
			虛空泡泡裡會召喚眼睛攻擊敵人，並造成50%的傷害
			每次只能生成一個虛空泡泡
			'''
	}

	ChampionWarHorn: {
		DisplayName: 英靈戰號
		Tooltip:
			'''
			釋放追蹤的音波
			"CHARGE!"
			'''
	}

	ConcussiveInstrument: {
		DisplayName: 震盪性儀器
		Tooltip:
			'''
			打擊樂器攻擊時，會在敵人身上擲出一個錘子
			"這是……只是一把錘子?"
			'''
	}

	DeathsingerPotion: {
		DisplayName: 死亡歌者藥水
		Tooltip: 增加7%音波傷害和音波演奏速度
	}

	ExecutionersContract: {
		DisplayName: 劊子手協議
		Tooltip:
			'''
			牧師鐮刀的彈幕擊中敵人時也能獲得靈魂精華
			"把他們的靈魂帶給我…"
			'''
	}

	FanDonations: {
		DisplayName: 粉絲捐款
		Tooltip:
			'''
			所有樂器擊中敵人會產生爆炸，光輝大小取決於演奏的樂器和造成的暴擊傷害降低50%
			穿透性絃樂器攻擊每次擊中後速度增加，不再降低傷害
			絃樂器的彈幕在與實體方塊碰撞時產生的效果也能在敵人身上產生
			打擊樂器攻擊時，會在敵人身上擲出一個錘子
			電子樂器的彈幕速度大幅提升
			最大靈感增加5點
			"賣得並不好，但至少有人好心地提供了幫助…"
			'''
	}

	HeadHunter: {
		DisplayName: 獵頭者
		Tooltip:
			'''
			鐮刀定向揮舞然後旋轉兩圈
			此武器獲得靈魂精華或暴擊時生成冰碎片跟隨妳
			長期處於戰鬥狀態也會生成冰碎片但是傷害較弱
			冰碎片給予玩家10點防禦力
			右鍵或者更換武器時會向光標附近的敵人釋放所有冰碎片
			冰碎片命中時會造成3倍傷害，較弱的冰碎片造成1倍傷害
			最多可以擁有四片冰碎片
			"屬於經營著咖啡店的惡魔......"
			'''
	}

	ImpulseAmplifier: {
		DisplayName: 脈衝揚聲器
		Tooltip:
			'''
			電子樂器的彈幕速度大幅提升
			"不，它不會比火箭飛得更快!"
			'''
	}

	InspirationRegenerationPotion: {
		DisplayName: 靈感恢復藥水
		Tooltip: 增加靈感恢復速度
	}

	JellyfishJam: {
		DisplayName: 水母狂想曲
		Tooltip: 釋放跳舞的水母刺穿敵人
	}

	LichWhip: {
		DisplayName: 笞魂刑具
		Tooltip:
			'''
			揮出由靈魂之火賦予力量的三重鞭
			敵人被鞭打後會流血
			流血的靈魂會釋放一根彩線治癒周圍的玩家
			"用來折磨死後靈魂的工具"
			'''
	}

	Loudener: {
		DisplayName: 擴音器
		Tooltip:
			'''
			管樂器和銅管樂器擊中敵人會產生金色光輝
			金色光輝大小取決於演奏的樂器
			爆炸造成的暴擊傷害降低50%
			"你有消音器，我有擴音器!"
			'''
	}

	LunateCharm: {
		DisplayName: 新月護身符
		Tooltip: 取消牧師盔甲帶來的非光輝傷害削減
	}
	RedCresent: {
		DisplayName: 緋紅新月
		Tooltip:
			'''
			釋放蝙蝠攻擊敵人，蝙蝠會回到你身邊
			蝙蝠造成的1/3傷害用來恢復吸血值
			右鍵釋放蝙蝠，蝙蝠會追蹤並治癒其他玩家
			每次消耗10點吸血值
			蝙蝠治癒<healAmount>點生命值，不會觸發治療效果
			但是，治療隊友會退還一些法力值給予治療者
			吸血值: <bloodSiphon>
			<legendaryModeOnly>在傳奇模式下使用需要生命值
			"蝙蝠的美妙歌謠"
			'''
	}

	MagicalHarp: {
		DisplayName: "{$ItemName.MagicalHarp}"
		Tooltip: ""
	}

	Oneirophobia: {
		DisplayName: 恐夢症
		Tooltip:
			'''
			釋放多種類的幻影武器
			第一，二次攻擊時，武器會變成一把幻影劍
			第一次攻擊會產生強烈的衝擊波，第二次攻擊會產生三個衝擊波
			第三次攻擊時，武器的刀刃脫落並向前拋出
			然後武器會變成一把幻影鐮刀
			第四次攻擊時，鐮刀旋轉並釋放追蹤敵怪的光束
			第五次攻擊時，武器會變成幻影魔杖
			釋放不穩定的能量球，並在一段時間後爆炸
			第六次攻擊時，此武器會變成帶有鎖定敵怪的幻影鐳射槍
			不使用武器時，生成幻影僕從為你而戰
			"對夢和噩夢的非理性恐懼的表現"
			'''
	}

	QueenJellyPin: {
		DisplayName: "{$Mods.ThoriumRework.Items.QueenJellyPinCosmetic.DisplayName}"
		Tooltip:
			'''
			免疫泡泡
			在玩家身上召喚可以鎖定敵人的觸手
			觸手的傷害會隨著玩家防禦提升
			觸手擊中敵人後可提升生命再生與資源再生
			{$Mods.ThoriumRework.Items.QueenJellyPinCosmetic.Tooltip}
			'''
	}

	QueenJellyPinCosmetic: {
		DisplayName: 皇后飾針
		Tooltip: '''"看！在你頭旁邊！"'''
	}

	PickShapedPebble: {
		DisplayName: 鋤形卵石
		Tooltip:
			'''
			絃樂器的彈幕在與實體方塊碰撞時產生的效果也能在敵人身上產生
			"這是搖滾音樂!"
			'''
	}

	PocketEnergyStorm: {
		DisplayName: 可擕式能量風暴
		Tooltip:
			'''
			投擲一個不穩定的能量球，將花崗岩能量溢向目標
			被溢散的敵怪多受5%傷害
			按住左鍵讓能量球在你身邊環繞
			鬆開左鍵將你身邊所有的能量球向你滑鼠位置發射
			一次最多20個能量球
			不會增加疲憊值
			"賜予能量球新的意義"
			'''
	}

	RepurposedStarCaller: {
		DisplayName: 星際召喚器
		Tooltip:
			'''
			召喚監察者核心為你而戰
			火焰核心燃燒目標，生命核心毒害目標，寒冰核心造成冷凍
			"我們收到你的資訊了，現在有什麼指示?"
			'''
	}

	SealedContract: {
		DisplayName: 正式契約
		Tooltip:
			'''
			最大生命增加60
			治療法術會額外治療5點生命值
			牧師鐮刀的彈幕擊中敵人時也能獲得靈魂精華
			取消牧師盔甲帶來的非光輝傷害削減
			"正式達成協議!"
			'''
	}

	Shellxophone: {
		DisplayName: 深海奧德賽
		Tooltip:
			'''
			左鍵釋放兩根彈跳並追蹤敵怪的海淵漣漪
			右鍵釋放追蹤隊友的水滴，使用10點靈感值並治療隊友
			治療效果會根據隊友的咒音增幅等級而增加
			"喚醒蟄伏淵洋的生靈，奏響世間至韻之聲"
			'''
	}

	SierraChimera: {
		DisplayName: 至高嵌合體
		Tooltip:
			'''
			免疫[i:ThoriumRework/QueenJellyPin]泡泡，[i:ThoriumRework/VampireCape]流血和[i:ThoriumRework/VampireCape]吸血鬼之咒
			[i:ThoriumRework/QueenJellyPin] 在玩家身上召喚可以鎖定敵人的觸手，觸手擊中敵人後可提升生命再生與資源再生
			[i:ThoriumRework/QueenJellyPin] 觸手的傷害會隨著玩家防禦提升
			[i:ThoriumRework/VampireCape] 啟動血蝠群舞時，受到的傷害大幅降低，敵人不太可能以你為目標
			[i:ThoriumRework/ZephyrWings] 疾風鉤的半空抓取效果可以延長飛行時間
			[i:ThoriumRework/ZephyrWings] 滑翔一段時間後，可以再次使用疾風鉤，造成傷害可以縮短其冷卻時間
			'''
	}

	StarScoutReticle: {
		DisplayName: "{$Mods.ThoriumRework.Items.StarScoutReticleCosmetic.DisplayName}"
		Tooltip:
			'''
			獲得在太空呼吸的能力與夜視能力
			使用衝刺會將你傳送一段距離
			對特殊衝刺無效
			若你不能衝刺，則給予衝刺能力
			{$Mods.ThoriumRework.Items.StarScoutReticleCosmetic.Tooltip}
			'''
	}

	StarScoutReticleCosmetic: {
		DisplayName: 銀河偵察護罩
		Tooltip: '''"怕黑？不用怕，有我在！"'''
	}

	StellarTune: {
		DisplayName: "{$ItemName.SparkleGuitar}"
		Tooltip: "{$ItemTooltip.SparkleGuitar}"
	}

	ValkyrienSkyStone: {
		DisplayName: 瓦爾基裡天空之石
		Tooltip:
			'''
			[i:ThoriumRework/StarScoutReticle] 獲得在太空呼吸的能力與夜視能力
			[i:ThoriumRework/StarScoutReticle]使用衝刺會將你傳送一段距離，若你不能衝刺，則給予衝刺能力
			[i:ThoriumRework/BannerofWar] 戰鬥中，你的傷害與額外治療量會隨時間增加，這些增益在你脫戰後會逐漸減少
			[i:ThoriumRework/BannerofWar] 戰鬥中會不斷釋放治療脈衝，回復隊友等同于額外治療量的生命，咒音增幅範圍也會影響治療脈衝的範圍
			[i:ThoriumRework/BannerofWar] 脈衝的頻率會隨著戰鬥時間增加
			[i:ThoriumRework/BandofCratons] 獲得40點生命護盾，免疫能量超載，且使你的攻擊施加能量超載
			[i:ThoriumRework/BandofCratons] 失去護盾時，根據失去的量回復玩家的資源，一次性失去超過20點護盾時，會製造電磁爆炸摧毀附近的3個彈幕
			'''
	}

	VampireCape: {
		DisplayName: "{$Mods.ThoriumRework.Items.VampireCapeCosmetic.DisplayName}"
		Tooltip: 免疫流血與吸血鬼之咒
	}

	VampireCapeCosmetic: {
		DisplayName: 吸血蝙蝠披風
		Tooltip: ""
	}

	ZephyrsRuin: {
		DisplayName: 西風殘垣
		Tooltip:
			'''
			投矛會刺入敵人或物塊
			一段時間後，召喚閃電攻擊敵人或物塊
			暴擊會立即釋放一次閃電
			不會增加疲憊值
			"人們說閃電不會在同一個地方擊中兩次"
			'''
	}

	ZephyrWings: {
		DisplayName: "{$Mods.ThoriumRework.Items.ZephyrWingsCosmetic.DisplayName}"
		Tooltip:
			'''
			{$Mods.ThoriumRework.Items.ZephyrWingsCosmetic.Tooltip}
			疾風鉤的半空抓取效果可以延長飛行時間
			滑翔一段時間後，可以再次使用疾風鉤
			造成傷害可以縮短疾風鉤的冷卻時間
			'''
	}

	ZephyrWingsCosmetic: {
		DisplayName: 疾風之翼
		Tooltip:
			'''
			可飛行和緩慢墜落
			與{$ItemName.CreativeWings}同級
			'''
	}
}

Buffs: {
	Deathsinger: {
		DisplayName: 死亡歌者
		Description: 增加7%音波傷害和音波演奏速度
	}

	Inspired: {
		DisplayName: 啟發
		Description: 增加靈感恢復速度
	}

	SoulBleed: {
		DisplayName: 靈魂流血
		Description: 你的靈魂正在消散……
	}

	StarCalled: {
		DisplayName: 星際的呼喚
		Description: 他們回應了你的信號
	}

	TerminalLucidity: {
		DisplayName: "[c/FF7F00:混亂的現實]"
		Description:
			'''
			[c/FF7F00:-BOSS攻擊方式-]
			[c/FF7F00:當此減益存在時，噬夢者不會受到傷害]
			[c/FF7F00:減益倒計時結束會立刻殺死玩家]
			[c/FF7F00:觸摸穩定的現實裂縫，進行傷害輸出階段並重置此減益倒計時]
			[c/FF7F00:穩定的現實裂縫是紫色法陣]
			[c/FF1CAE:漢化備註:擊敗一次始生災靈後，無視此減益，減益倒計時結束會削減血條，但不會代碼殺]
			[c/FF7F00:"等待命運..."]
			'''
	}

	LucidRetaliation: {
		DisplayName: "[c/FF7F00:恢復的現實]"
		Description:
			'''
			[c/FF7F00:-BOSS攻擊方式-]
			[c/FF7F00:當此增益存在時，噬夢者會受到傷害]
			[c/FF7F00:被完全成型的現實裂縫擊中後，會提前移除此增益]
			[c/FF1CAE:漢化備註:不穩定的現實裂縫更改為完全成型的現實裂縫，是因為條件觸發苛刻]
			[c/FF7F00:完全成型的現實裂縫是噬夢者的黑色裂縫攻擊]
			[c/FF7F00:允許無限飛行]
			[c/FF7F00:"等待命運..."]
			'''
	}
}

Prefixes: {
	Careless: {
		DisplayName: 淡漠
		Description: 增加2點生命消耗
	}

	Risky: {
		DisplayName: 冒險
		Description: 增加1點生命消耗
	}

	Suicidal: {
		DisplayName: 自殺
		Description: 增加3點生命消耗
	}
}

Configs: {
	ReworkConfig: {
		DisplayName: 視覺設置

		flash: {
			Label: 閃光強度
			Tooltip: 設置閃光的明暗度
		}

		overlay: {
			Label: 覆蓋強度
			Tooltip: 設置螢幕覆蓋強弱度
		}

		seizures: {
			Label: 光敏警告提示
			Tooltip: 啟動世界後有光敏警告提示
		}

		bossRenames: {
			Label: BOSS名稱重命名
			Tooltip: 啟用時，為瑟銀模組的boss進行重新重命名
		}

		lichOutline: {
			Label: "[i:ThoriumMod/LichMask]巫妖氛圍強度"
			Tooltip:
				'''
				控制巫妖身邊的紅光強度
				僅限改變過的有影響，未經過改變的沒有影響
				如果希望適用原始設計或者難以看清情況下使用此設置
				'''
		}
	}

	CompatConfig: {
		DisplayName: 模組相容性設置

		healthScale: {
			Label: 瑟銀BOSS生命值增加
			Tooltip: 讓瑟銀BOSS的生命值乘以當前數值
		}

		damageScale: {
			Label: 瑟銀BOSS傷害加成
			Tooltip: 讓瑟銀的boss的攻擊傷害乘以當前數值
		}

		speedScale: {
			Label: 瑟銀BOSS速度加成
			Tooltip:
				'''
				讓瑟銀的boss的速度乘以當前數值
				有更高的目標挑戰BOSS推薦2倍速度（最高2倍速度）
				災厄煉獄模組推薦使用1.35倍速度
				'''
		}

		extraItems: {
			Label: 額外物品
			Tooltip:
				'''
				(可選)
				在這個模組增加一些不相關的物品
				'''
		}

		extraPotions: {
			Label: 額外藥劑內容
			Tooltip:
				'''
				(可選)
				增加與瑟銀的職業有關的增益藥水
				'''
		}

		extraPrefixes: {
			Label: 額外修飾語內容
			Tooltip:
				'''
				(可選)
				增加與瑟銀的職業有關的修飾語
				'''
		}

		masterDrops: {
			Label: 大師模式掉落
			Tooltip:
				'''
				(推薦!)
				讓瑟銀模組的boss的大師掉落武器，在復仇模式或永恆模式也可以掉落
				'''
		}

		masterDropsAreNonExclusive: {
			Label: 專家模式下掉落大師模式專屬武器
			Tooltip:
				'''
				專家模式下掉落大師模式專屬武器
				如果你不喜歡玩大師或其他其他模組只能在專家模式下遊玩
				(例如：fargo魂模組永恆模式在大師模式下變成受虐模式，或者災厄煉獄模組無法開啟大師模式)
				'''
		}

		itemReworks: {
			Label: 重置原瑟銀一些武器
			Tooltip:
				'''
				(推薦!)
				讓原瑟銀模組武器更好的使用
				'''
		}

		postDoGRag: {
			Label: 在災厄與法狗魂石裡重置始生災靈階級
			Tooltip:
				'''
				(推薦!)
				災厄中始生災靈在神明吞噬者前召喚
				法狗魂石中始生災靈在宇宙英靈前召喚
				如果兩模組都啟動，則在兩個boss兩之間召喚
				'''
		}

		vanillaBard: {
			Label: 讓星星吉他和魔法豎琴成為吟遊詩人武器
			Tooltip: 讓星星吉他和魔法豎琴成為吟遊詩人武器並加入灌注附魔效果
		}

		DoD: {
			Label: 神明吞噬者有許許多多的夢想 (玩笑設置)
			Tooltip:
				'''
				這是一個玩笑設置，它讓神明吞噬者擁有噬夢者部分彈幕攻擊
				可能公平，也可能不公平
				'''
		}

		thorlamityBR: {
			Label: 瑟銀boss加入災厄bossrush
			Tooltip: 瑟銀boss加入災厄bossrush，根據適當的階級排序
		}

		defenseDamage: {
			Label: 防禦傷害支持
			Tooltip: 若啓用災厄模組某些瑟銀BOSS攻擊會造成防禦傷害
		}

		eternityModeOnly: {
			Label: 僅限永恆模式
			Tooltip:
				'''
				模組中BOSS的重製內容僅在永恆模式開啓時生效
				如果啓用大師掉落的武器在永恆模式也會掉落
				此外，瑟銀BOSS也可以掉落永恆模式的飾品
				如果未安裝fargo魂石模組此設置無用
				'''
		}

		infernumModeOnly: {
			Label: 只有煉獄模式
			Tooltip:
				'''
				只有在煉獄開啟時BOSS重置會生效
				如果未安裝煉獄模組此設置無用
				'''
		}
	}

