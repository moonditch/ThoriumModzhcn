		terminalLucidity: {
			Label: "[i:ThoriumMod/TheOmegaCore]混亂的現實最低難度"
			Tooltip:
				'''最低難度的"混亂的現實"可出現在
				0 - 只有Boss rush
				1 - 適用所有
				2 - 大師，復仇
				3 - 傳奇，死亡，永恆
				4 - 天頂，煉獄，受虐，永恆死亡
				'''
		}
	}

