		DisplayName: 启发
		Description: 增加灵感恢复速度
	}

	SoulBleed: {
		DisplayName: 灵魂流血
		Description: 你的灵魂正在消散……
	}

	StarCalled: {
		DisplayName: 星际的呼唤
		Description: 他们回应了你的信号
