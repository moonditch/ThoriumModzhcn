			造成伤害可以缩短疾风钩的冷却时间
			'''
	}

	ZephyrWingsCosmetic: {
		DisplayName: 疾风之翼
		Tooltip:
			'''
			可飞行和缓慢坠落
			与{$ItemName.CreativeWings}同级
			'''
	}
}

