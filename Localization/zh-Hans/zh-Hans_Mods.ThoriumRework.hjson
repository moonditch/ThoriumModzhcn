	Simplified: {
		DisplayName: 简单
		Description: -25%计时器速度
	}

	Suicidal: {
		DisplayName: 自杀
		Description: +3点生命消耗
	}
}

Configs: {
	ReworkConfig: {
		DisplayName: 视觉设置

		flash: {
			Label: 闪光强度
			Tooltip: 设置闪光的明暗度
		}

		overlay: {
			Label: 覆盖强度
			Tooltip: 设置屏幕覆盖强弱度
		}

		seizures: {
			Label: 光敏警告提示
			Tooltip: 启动世界后有光敏警告提示
		}

		bossRenames: {
			Label: BOSS名称重命名
			Tooltip: 启用时，为瑟银模组的boss进行重新重命名
		}

		starScouterEnrageText: {
			Label: "[i:ThoriumMod/StarScouterMask]星际监察者能量愤怒文本"
			Tooltip:
				'''
				是否显示星际监察者被激怒的文本弹窗
				此设置仅适用于重制版星际监察者，未重制版不受此设置影响，因为它不会被激怒
				'''
		}

		starScouterEnrageVisuals: {
			Label: "[i:ThoriumMod/StarScouterMask]星际侦察兵激怒视觉"
			Tooltip:
				'''
				星际监察者被激怒时是否为红色
				此设置仅适用于重制版星际监察者，未重制版不受此设置影响，因为它不会被激怒
				'''
		}

		lichOutline: {
			Label: "[i:ThoriumMod/LichMask]巫妖氛围强度"
			Tooltip:
				'''
				控制巫妖身边的红光强度
				仅限改变过的有影响，未经过改变的没有影响
				如果希望适用原始设计或者难以看清情况下使用此设置
				'''
		}
	}

	CompatConfig: {
		DisplayName: 模组兼容性设置

		healthScale: {
			Label: 瑟银BOSS生命值增加
			Tooltip: 让瑟银BOSS的生命值乘以当前数值
		}

		damageScale: {
			Label: 瑟银BOSS伤害加成
			Tooltip: 让瑟银的boss的攻击伤害乘以当前数值
		}

		speedScale: {
			Label: 瑟银BOSS速度加成
			Tooltip:
				'''
				让瑟银的boss的速度乘以当前数值
				有更高的目标挑战BOSS推荐2倍速度（最高2倍速度）
				'''
		}

		sheathFix: {
			Label: 盔甲修复和改进
			Tooltip: 修复了一些与刀鞘相关的不一致问题，并允许他们在更多剑上工作
		}

		terraItemsFix: {
			Label: 瑟银的泰拉物品一致性
			Tooltip:
				'''
				(强烈推荐!)
				将瑟银所有泰拉武器的合成配方改为与原版泰拉刃类似的配方。
				如果安装了“非官方灾厄吟游诗人和牧师”模组，则会禁用此功能，因为该模组已经实现了此功能。
				'''
		}

		extraItems: {
			Label: 额外物品
			Tooltip:
				'''
				(可选)
				在这个模组增加一些不相关的物品
				'''
		}

		extraPotions: {
			Label: 额外药剂内容
			Tooltip:
				'''
				(可选)
				增加与瑟银的职业有关的增益药水
				'''
		}

		extraPrefixes: {
			Label: 额外修饰语内容
			Tooltip:
				'''
				(可选)
				增加与瑟银的职业有关的修饰语
				'''
		}

		masterDrops: {
			Label: 大师模式掉落
			Tooltip:
				'''
				(推荐!)
				让瑟银模组的boss的大师掉落武器，在复仇模式或永恒模式也可以掉落
				'''
		}

		masterDropRate: {
			Label: 大师模式掉落率（%）
			Tooltip: 注意：如果启用了“仅永恒模式”设置，此项在永恒模式下会被覆盖，以匹配其他永恒模式首领掉落的掉率。
		}

		masterDropsAreNonExclusive: {
			Label: 专家模式下掉落大师模式专属武器
			Tooltip:
				'''
				专家模式下掉落大师模式专属武器
				如果你不喜欢玩大师或其他其他模组只能在专家模式下游玩
				(例如：fargo魂模组永恒模式在大师模式下变成受虐模式，或者灾厄炼狱模组无法开启大师模式)
				'''
		}

		itemReworks: {
			Label: 重置原瑟银一些武器
			Tooltip:
				'''
				(推荐!)
				让原瑟银模组武器更好的使用
				'''
		}

		postDoGRag: {
			Label: 在灾厄与法狗魂石里重置始生灾灵阶级
			Tooltip:
				'''
				(推荐!)
				灾厄中始生灾灵在神明吞噬者前召唤
				法狗魂石中始生灾灵在宇宙英灵前召唤
				如果两模组都启用，则介于两者之间。
				'''
		}

		vanillaBard: {
			Label: 让星星吉他和魔法竖琴成为吟游诗人武器
			Tooltip: 让星星吉他和魔法竖琴成为吟游诗人武器并加入灌注附魔效果
		}

		DoD: {
			Label: 神明吞噬者有许许多多的梦想 (玩笑设置)
			Tooltip:
				'''
				这是一个玩笑设置，它让神明吞噬者拥有噬梦者部分弹幕攻击
				可能公平，也可能不公平
				'''
		}

		thorlamityBR: {
			Label: 瑟银boss加入灾厄bossrush
			Tooltip: 瑟银boss加入灾厄bossrush，根据适当的阶级排序
		}

	auricBar: {
			Label: 圣金源锭使用瑟银材料
			Tooltip: 圣金源锭需要始生灾灵精华制作
		}

		defenseDamage: {
			Label: 防御伤害支持
			Tooltip: 若启用灾厄模组某些瑟银BOSS攻击会造成防御伤害
		}

		eternityModeOnly: {
			Label: 仅限永恒模式
			Tooltip:
				'''
				模组中BOSS的重制内容仅在永恒模式开启时生效
				如果启用大师掉落的武器在永恒模式也会掉落
				此外，瑟银BOSS现在可以掉落永恒模式的饰品
				如果未安装fargo魂石模组此设置无用
				'''
		}

		infernumModeOnly: {
			Label: 只有炼狱模式
			Tooltip:
				'''
				只有在炼狱开启时BOSS重置会生效
				如果未安装炼狱模组此设置无用
				'''
		}
	}

	ReworkTogglesConfig: {
		DisplayName: BOSS重置开/关

		bird: {
			Label: "[i:ThoriumMod/TheGrandThunderBirdMask]惊雷王鹰"
			Tooltip: 惊雷王鹰重置
		}

		jelly: {
			Label: "[i:ThoriumMod/QueenJellyfishMask]水母皇后"
			Tooltip: 水母皇后重置
		}

		qjLagReduction: {
			Label: "[i:ThoriumMod/QueenJellyfishMask]水母皇后气泡柱延迟优化模式"
			Tooltip:
				'''
				为在水母皇后的气泡柱攻击中遇到性能问题的玩家提供
				0 - 禁用（如果你的设备不卡顿，请保持此设置）
				1 - 仅限单人模式
				2 - 始终启用（警告： 此优化在多人模式下可能无法正常工作！）
				'''
		}

		bat: {
			Label: "[i:ThoriumMod/ViscountMask]蝙蝠子爵"
			Tooltip: 蝙蝠子爵重置
		}

		champ: {
			Label: "[i:ThoriumMod/BuriedChampionMask]英灵遗骸"
			Tooltip: 英灵遗骸重置
		}

		ges: {
			Label: "[i:ThoriumMod/GraniteEnergyStormMask]花岗岩流能风暴"
			Tooltip: 花岗岩流能风暴重置
		}

		scout: {
			Label: "[i:ThoriumMod/StarScouterMask]星际监察者"
			Tooltip: 星际监察者重置
		}

		coznix: {
			Label: "[i:ThoriumMod/FallenBeholderMask]堕落注视者"
			Tooltip: 堕落注视者重置
		}

		strider: {
			Label: "[i:ThoriumMod/BoreanStriderMask]极地遁蛛"
			Tooltip: 极地遁蛛重置
		}

		lich: {
			Label: "[i:ThoriumMod/LichMask]巫妖"
			Tooltip: 巫妖重置
		}

		abyssion: {
			Label: "[i:ThoriumMod/ForgottenOneMask]遗忘之主"
			Tooltip: 遗忘之主重置
		}

		requireAbyssion: {
			Label: "[i:ThoriumMod/ForgottenOneMask]将深渊纳入主线进度"
			Tooltip:
				'''
				必须击败遗忘之主与石巨人才能生成邪教徒
				在未生成深海的世界中，此功能将自动禁用
				'''
		}

		rag: {
			Label: "[i:ThoriumMod/TheOmegaCore]始生灾灵"
			Tooltip: 始生灾灵重置
		}

		terminalLucidity: {
			Label: "[i:ThoriumMod/TheOmegaCore]混乱的现实最低难度"
			Tooltip:
				'''
				最低难度的"混乱的现实"可出现在
				0 - 只有Boss rush
				1 - 适用所有
				2 - 大师，复仇
				3 - 传奇，死亡，永恒
				4 - 天顶，炼狱，受虐，永恒死亡
				'''
		}

		corpsebloom: {
			Label: 绝命花
			Tooltip: 重做了绝命花，使其在随机遭遇时不再那么烦人
		}

		hags: {
			Label: 巫婆
			Tooltip: 将巫婆重做为迷你BOSS，使其不那么烦人
		}
	}

