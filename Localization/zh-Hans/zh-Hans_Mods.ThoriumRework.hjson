		DisplayName: 瑟银哨子
		Tooltip: 发射短射程的闪电弹幕
	}

	UndyingGaze: {
		DisplayName: "{$Mods.ThoriumRework.Items.UndyingGazeCosmetic.DisplayName}"
		Tooltip:
			'''
			任何暴击现在都会获得灵魂精华
			消耗生命值的攻击会在命中任意目标时获得灵魂精华
			原本会获得灵魂精华的攻击会额外获得一层充能
			'''
	}

	UndyingGazeCosmetic: {
		DisplayName: 不灭凝视
		Tooltip: 你的双眼散发着微弱光芒
	}

	ValadiumHeavyScythe: {
		DisplayName: 虚金重镰
		Tooltip:
			'''
			这把镰刀是定向挥舞而不是旋转
			释放一道短距离可贯穿敌怪的暗能量波
			造成伤害会以异界能量爆破敌人
			'''
	}

	ValkyrienSkyStone: {
		DisplayName: 瓦尔基里天空之石
		Tooltip:
			'''
			[i:ThoriumRework/StarScoutReticle] 获得在太空呼吸的能力与夜视能力
			[i:ThoriumRework/StarScoutReticle]使用冲刺会将你传送一段距离，若你不能冲刺，则给予冲刺能力
			[i:ThoriumRework/BannerofWar] 战斗中，你的伤害与额外治疗量会随时间增加，这些增益在你脱战后会逐渐减少
			[i:ThoriumRework/BannerofWar] 战斗中会不断释放治疗脉冲，回复队友等同于额外治疗量的生命，咒音增幅范围也会影响治疗脉冲的范围
			[i:ThoriumRework/BannerofWar] 脉冲的频率会随着战斗时间增加
			[i:ThoriumRework/BandofCratons] 获得40点生命护盾，免疫能量过载，且使你的攻击施加能量过载
			[i:ThoriumRework/BandofCratons] 失去护盾时，根据失去的量回复玩家的资源，一次性失去超过20点护盾时，会制造电磁爆炸摧毁附近的3个弹幕
			'''
	}

	VampireCape: {
		DisplayName: "{$Mods.ThoriumRework.Items.VampireCapeCosmetic.DisplayName}"
		Tooltip: 免疫流血与吸血鬼之咒
	}

	VampireCapeCosmetic: {
		DisplayName: 吸血蝙蝠披风
		Tooltip: ""
	}

