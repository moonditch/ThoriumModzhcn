Achievements: {
	CoreCollapse: {
		FriendlyName: 核心坍缩
		Description: 在6秒内击败星际监察者的三个核心
	}

	ElectricalSafetyTraining: {
		FriendlyName: 电气安全培训
		Description: 在不被流能脉冲导体造成伤害的情况下击败花岗岩流能风暴
	}

	MyBatsAreKindaChamberless: {
		FriendlyName: 我的小蝙蝠要饿扁了…
		Description: 在不让任何贪食小蝙蝠偷取你的生命值的情况下击败蝙蝠子爵
	}

	OnEvenGrounds: {
		FriendlyName: 公平竞争
		Description: 在一阶段只造成近战伤害，二阶段只造成远程伤害，三阶段只造成魔法伤害或召唤伤害的情况下击败英灵遗骸
	}

	PreservationEfforts: {
		FriendlyName: 保护努力
		Description: 在不伤害风暴雏鸟的情况下击败惊雷王鹰
	}
}
