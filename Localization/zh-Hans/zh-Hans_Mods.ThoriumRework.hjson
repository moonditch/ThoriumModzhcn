Items: {
	ADropRateTooLow: {
		DisplayName: 掉率太低？
		Tooltip: By (Not) Una Nancy Owen
	}

	BandofCratons: {
		DisplayName: "{$Mods.ThoriumRework.Items.BandofCratonsCosmetic.DisplayName}"
		Tooltip:
			'''
			免疫能量过载，且使你的攻击施加能量过载
			获得40点生命护盾
			失去护盾时，根据失去的量回复玩家的资源
			一次性失去超过20点护盾时，会制造电磁爆炸摧毁附近的3个弹幕
			{$Mods.ThoriumRework.Items.BandofCratonsCosmetic.Tooltip}
			'''
	}

	BandofCratonsCosmetic: {
		DisplayName: 古陆核之带
		Tooltip: “非常耐用，甚至能承受大陆漂移的伟力”
	}

	BannerofWar: {
		DisplayName: "{$Mods.ThoriumRework.Items.BannerofWarCosmetic.DisplayName}"
		Tooltip:
			'''
			战斗中，你的伤害与额外治疗量会随时间增加
			这些增益在你脱战后会逐渐减少
			战斗中会不断释放治疗脉冲，回复队友等同于额外治疗量的生命
			脉冲的频率会随着战斗时间增加
			咒音增幅范围也会影响治疗脉冲的范围
			'''
	}

	BannerofWarCosmetic: {
		DisplayName: 战争之旗
		Tooltip: ""
	}

	BeholderBlade: {
		DisplayName: 凝视者之刃
		Tooltip:
			'''
			每挥舞的第三和四次会发射凝视光束
			暴击时，敌人身上会产生虚空泡泡
			虚空泡泡里会召唤眼睛攻击敌人，并造成50%的伤害
			每次只能生成一个虚空泡泡
			'''
	}

	BeholderHeart: {
		DisplayName: 凝视者之心
		Tooltip:
			'''
			最大生命值提升10，额外治疗量提升1
			每为友方恢复30点生命值会释放一道造成伤害的光辉能量
			此外，你会回复等同于额外治疗量的生命值
			'''
	}

	BeholderTentacles: {
		DisplayName: "{$Mods.ThoriumRework.Items.BeholderTentaclesCosmetic.DisplayName}"
		Tooltip:
			'''
			攻击施加烧焦减益，对烧焦目标造成的伤害提高20%
			{$Mods.ThoriumRework.Items.BeholderTentaclesCosmetic.Tooltip}
			'''
	}

	BeholderTentaclesCosmetic: {
		DisplayName: 注视者的触手
		Tooltip:
			'''
			拥有{$ItemName.FrogLeg}和{$ItemName.LavaWaders}的效果，但没有熔岩免疫效果
			“这一定是威尔的”
			'''
	}

	BiterofSouls: {
		DisplayName: 啖魂者
		Tooltip:
			'''
			投掷迷你噬魂怪，迷你噬魂怪会在飞行一段距离后进入狂暴状态
			狂暴状态下，噬魂怪可以无限穿透，并多次攻击同一目标
			'''
	}

	DuelistSheath: {
		DisplayName: 决斗者剑鞘
		Tooltip:
			'''
			如果手持且不使用 {1} 后未进行攻击会在下一次挥剑将造成 {0}% 暴击伤害
			受到攻击或造成暴击后，近战攻击速度与暴击率将提升，持续 {1} 秒
			'''
	}

	ChampionWarHorn: {
		DisplayName: 英灵战号
		Tooltip:
			'''
			释放追踪的音波
			"CHARGE!"
			'''
	}

	ChironsCure: {
		DisplayName: 喀戎之愈
		Tooltip: 消耗生命发射一道能治愈基础负面效果的治疗光束
	}

	ConcussiveInstrument: {
		DisplayName: 震荡性仪器
		Tooltip:
			'''
			打击乐器攻击时，会在敌人身上掷出一个锤子
			“这是……只是一把锤子？”
			'''
	}

	CrystallizedFinality: {
		DisplayName: 终末结晶
		Tooltip:
			'''
			拥有[i:ThoriumRework/BeholderTentacles]{$ItemName.FrogLeg}、[i:ThoriumRework/BeholderTentacles]{$ItemName.LavaWaders}（不包括熔岩免疫）和[i:ThoriumRework/StriderMouthguard]{$ItemName.HandWarmer}的效果
			[i:ThoriumRework/BeholderTentacles][i:ThoriumRework/StriderMouthguard] 攻击会造成霜冻和狱火，对受任一减益影响的目标造成更高伤害，并从其身上获得护盾
			[i:ThoriumRework/StriderMouthguard][i:ThoriumRework/UndyingGaze] 按住攻击可生成至多三只寒霜螨虫，停止攻击即可释放它们，命中时获得灵魂精华
			[i:ThoriumRework/UndyingGaze] 暴击会获得灵魂精华，消耗生命值或使你获得灵魂精华的攻击会获得更多灵魂精华
			[i:ThoriumRework/DeepDarkShellShield] 被动获得20点护盾，免疫击退，护盾提供的生命提升翻倍，同时提高防御属性
			“熵变的最后一幕”
			'''
	}

	DeathsingerPotion: {
		DisplayName: 死亡歌者药水
		Tooltip: 增加7%音波伤害和音波演奏速度
	}

	DeepDarkShellShield: {
		DisplayName: "{$Mods.ThoriumRework.Items.DeepDarkShellShieldCosmetic.DisplayName}"
		Tooltip:
			'''
			{$Mods.ThoriumRework.Items.DeepDarkShellShieldCosmetic.Tooltip}
			护盾提供的生命提升翻倍
			此外，护盾还会提高防御力和伤害减免
			'''
	}

	DeepDarkShellShieldCosmetic: {
		DisplayName: 深暗甲壳盾
		Tooltip:
			'''
			被动获得20点护盾
			免疫击退
			'''
	}

	DukeFish: {
		DisplayName: 鱼公爵
		Tooltip:
			'''
			长按左键吹出一个不停变大的泡泡，松开左键将其射出
			泡泡会治疗队友，并将他们包裹在保护罩中
			“顺带一提，他名字叫猪龙”
			'''
	}

	EaterPiper: {
		DisplayName: 噬魂笛
		Tooltip:
			'''
			召唤噬咬敌人的蠕虫
			无视15点护甲
			“给它一罐胡椒粉”
			'''
	}

	ElectronSpearTip: {
		DisplayName: 电涌矛尖
		Tooltip: 矛类武器会释放一簇可以重度烧伤敌人的等离子冲击波
	}

	ExecutionersContract: {
		DisplayName: 刽子手协议
		Tooltip:
			'''
			使用光辉镰刀获得灵魂精华时，会获得一层充能
			牧师镰刀的弹幕或非镰刀类武器造成的光辉伤害会消耗充能，以获得灵魂精华
			“把他们的灵魂带给我…”
			'''
	}

	FanDonations: {
		DisplayName: 粉丝捐款
		Tooltip:
			'''
			所有乐器击中敌人会产生爆炸，光辉大小取决于演奏的乐器和造成的暴击伤害降低50%
			穿透性弦乐器攻击每次击中后速度增加，不再降低伤害
			弦乐器的弹幕在与实体方块碰撞时产生的效果也能在敌人身上产生
			打击乐器攻击时，会在敌人身上掷出一个锤子
			电子乐器的弹幕速度大幅提升
			最大灵感增加5点
			“卖得并不好，但至少有人好心地提供了帮助…”
			'''
	}

	FlyingFlute: {
		DisplayName: 飞笛
		Tooltip:
			'''
			召唤一支带翅膀的飞笛攻击敌人
			飞笛每次攻击时给予你飞行时间II与资源再生I
			“它看起来像是一只会飞的长笛吗？”
			'''
	}

	GildedFlyingFlute: {
		DisplayName: 镀金飞笛
		Tooltip:
			'''
			增加{0}%音波伤害
			增加{1}%演奏速度
			增加{2}%管乐器追踪速度
			你的管乐器攻击现在会快速追踪敌人
			如果管乐器本身能追踪，则进一步增加追踪速度
			召唤一支带翅膀的飞笛攻击敌人
			飞笛每次攻击时给予你飞行时间II与资源再生I
			'''
	}

	HandheldRocket: {
		DisplayName: 手持式火箭
		Tooltip:
			'''
			掷出一枚手持式火箭，飞行一段距离后爆炸四次
			“口袋火箭！”
			'''
	}

	HeadHunter: {
		DisplayName: 猎头者
		Tooltip:
			'''
			镰刀定向挥舞然后旋转两圈
			此武器获得灵魂精华，暴击或处于战斗状态会生成跟随你的冰碎片
			每个冰碎片给予玩家10点防御力，最多存在四个
			右键或者更换武器时会向光标附近的敌人释放所有冰碎片
			“属于经营着咖啡店的恶魔……”
			'''
	}

	HelheimSoul: {
		DisplayName: 冥界之魂
		Tooltip:
			'''
			免疫[i:ThoriumRework/QueenJellyPin]泡泡、[i:ThoriumRework/VampireCape]流血、[i:ThoriumRework/VampireCape]吸血鬼之咒和[i:ThoriumRework/DeepDarkShellShield]击退
			获得[i:ThoriumRework/BeholderTentacles]{$ItemName.FrogLeg}、[i:ThoriumRework/BeholderTentacles]{$ItemName.LavaWaders}和[i:ThoriumRework/StriderMouthguard]{$ItemName.HandWarmer}的效果
			[i:ThoriumRework/BeholderTentacles][i:ThoriumRework/StriderMouthguard] 攻击会造成冻伤和狱火，对受任一减益影响的目标造成更高伤害，并从其身上获得护盾
			[i:ThoriumRework/StriderMouthguard][i:ThoriumRework/UndyingGaze] 按住攻击可生成至多三只寒霜螨虫，停止攻击即可释放它们，命中时获得灵魂精华
			[i:ThoriumRework/DeepDarkShellShield][i:ThoriumRework/BandofCratons] 被动获得40点护盾，免疫能量过载并使你的攻击造成能量过载，护盾提供的生命提升翻倍，同时提高防御属性
			[i:ThoriumRework/BandofCratons] 根据损失的护盾量恢复玩家资源，一次性损失超过20点护盾会产生电击，摧毁3个射弹
			[i:ThoriumRework/UndyingGaze] 暴击会获得灵魂精华，消耗生命值或使你获得灵魂精华的攻击会获得更多灵魂精华
			[i:ThoriumRework/QueenJellyPin] 在玩家身上召唤可以锁定敌人的触手，触手击中敌人后可提升生命再生与资源再生，触手伤害会随着玩家防御提升
			[i:ThoriumRework/VampireCape] 激活血蝠群舞时，受到的伤害大幅降低，敌人不太可能以你为目标
			[i:ThoriumRework/ZephyrWings] 疾风钩的半空抓取效果可以延长飞行时间
			[i:ThoriumRework/ZephyrWings] 滑翔一段时间后，可以再次使用疾风钩，造成伤害可以缩短其冷却时间
			[i:ThoriumRework/StarScoutReticle] 获得在太空呼吸的能力与夜视能力
			[i:ThoriumRework/StarScoutReticle] 使用冲刺会将你传送一段距离，若你不能冲刺，则给予冲刺能力
			[i:ThoriumRework/BannerofWar] 战斗中，你的伤害与额外治疗量会随时间增加，这些增益在你脱战后会逐渐减少
			[i:ThoriumRework/BannerofWar] 战斗中会不断释放治疗脉冲，回复队友等同于额外治疗量的生命，咒音增幅范围也会影响治疗脉冲的范围，脉冲的频率会随着战斗时间增加
			'''
	}

	HolySheath: {
		DisplayName: 圣惩剑鞘
		Tooltip:
			'''
			手持且不使用{1}秒后用剑攻击会暴击造成{0}%伤害
			暴击时在最后命中的目标处降下圣光
			圣光对多体节目标的伤害会有所衰减
			“其神威可令敌人惊呼其名”
			'''
	}

	ImpulseAmplifier: {
		DisplayName: 脉冲扬声器
		Tooltip: 电子乐器的弹幕速度大幅提升
	}

	InspirationRegenerationPotion: {
		DisplayName: 灵感恢复药水
		Tooltip: 增加灵感恢复速度
	}

	FluteofCurses: {
		DisplayName: 诅咒之笛
		Tooltip: 发射诅咒骷髅头，对敌人造成持续伤害
	}

	JellyfishJam: {
		DisplayName: 水母狂想曲
		Tooltip: 释放跳舞的水母刺穿敌人
	}

	KingTrumpet: {
		DisplayName: 菌王之号
		Tooltip:
			'''
			喷射一连串能感染敌人的孢子
			无视敌人10点护甲
			'''
	}

	Kusarigama: {
		DisplayName: 锁镰
		Tooltip:
			'''
			该连枷被视为镰刀
			以刀刃命中敌人会生成灵魂精华
			以刀柄命中敌人会生成滞留的治疗能量
			同时最多存在2团治疗能量
			'''
	}

	LichWhip: {
		DisplayName: 笞魂刑具
		Tooltip:
			'''
			挥出由灵魂之火赋予力量的三重鞭
			敌人被鞭打后会流血，流血的灵魂会释放一根彩线治愈周围的玩家
			“用来折磨死后灵魂的工具”
			'''
	}

	LodeStoneMagnetMace: {
		DisplayName: 地脉磁石链锤
		Tooltip:
			'''
			挥舞磁性链锤，首次命中时释放滞留的治疗能量
			同时最多可存在4团治疗能量
			造成伤害会剥离敌怪，使其受到的伤害提高10%并吸引链锤瞄准它
			'''
	}

	Loudener: {
		DisplayName: 扩音器
		Tooltip:
			'''
			管乐器和铜管乐器击中敌人会产生金色光辉
			金色光辉大小取决于演奏的乐器
			爆炸造成的暴击伤害降低50%
			“你有消音器，我有扩音器！”
			'''
	}

	LunateCharm: {
		DisplayName: 新月护身符
		Tooltip: 取消牧师盔甲带来的非光辉伤害削减
	}

	RedCresent: {
		DisplayName: 绯红新月
		Tooltip:
			'''
			释放蝙蝠攻击敌人，蝙蝠会回到你身边，并恢复吸血值
			右键消耗吸血值释放蝙蝠，蝙蝠会追踪并治愈其他玩家<healAmount>点生命值
			<legendaryModeOnly>在传奇模式下使用需要生命值
			吸血值: <bloodSiphon>
			“蝙蝠的美妙歌谣”
			'''
	}

	MagicalHarp: {
		DisplayName: "{$ItemName.MagicalHarp}"
		Tooltip: 发出速度不同的跳跃音符
	}

	NotSoLovelyLadies: {
		DisplayName: （不那么)可爱的女士们
		Tooltip:
			'''
			“你所在地区的热辣单身人士想要你！（已死，且被撕成碎片）”
			By (Not) Una Nancy Owen
			'''
	}

	Oneirophobia: {
		DisplayName: 恐梦症
		Tooltip:
			'''
			释放多种类的幻影武器
			第一，二次攻击时，武器会变成一把幻影剑
			第一次攻击会产生强烈的冲击波，第二次攻击会产生三个冲击波
			第三次攻击时，武器的刀刃脱落并向前抛出
			然后武器会变成一把幻影镰刀
			第四次攻击时，镰刀旋转并释放追踪敌怪的光束
			第五次攻击时，武器会变成幻影魔杖
			释放不稳定的能量球，并在一段时间后爆炸
			第六次攻击时，此武器会变成带有锁定敌怪的幻影激光枪
			不使用武器时，生成幻影仆从为你而战
			“对梦和噩梦的非理性恐惧的表现”
			'''
	}

	QueenJellyPin: {
		DisplayName: "{$Mods.ThoriumRework.Items.QueenJellyPinCosmetic.DisplayName}"
		Tooltip:
			'''
			免疫泡泡
			在玩家身上召唤可以锁定敌人的触手
			触手的伤害会随着玩家防御提升
			触手击中敌人后可提升生命再生与资源再生
			{$Mods.ThoriumRework.Items.QueenJellyPinCosmetic.Tooltip}
			'''
	}

	QueenJellyPinCosmetic: {
		DisplayName: 皇后饰针
		Tooltip: “看！在你头旁边！”
	}

	PickShapedPebble: {
		DisplayName: 锄形卵石
		Tooltip:
			'''
			弦乐器的弹幕在与实体方块碰撞时产生的效果也能在敌人身上产生
			“这是摇滚音乐!”
			'''
	}

	PocketEnergyStorm: {
		DisplayName: 便携式能量风暴
		Tooltip:
			'''
			投掷最多20不稳定的能量球，将花岗岩能量溢向目标
			被溢散的敌怪多受5%伤害
			松开左键以一次性释放所有的能量球
			不会增加疲惫值
			“赐予能量球新的意义”
			'''
	}

	RepurposedStarCaller: {
		DisplayName: 改装式星空召唤器
		Tooltip:
			'''
			召唤监察者核心为你而战
			火焰核心燃烧目标，生命核心毒害目标，寒冰核心造成冷冻
			“我们收到你的信息了，现在有什么指示？”
			'''
	}

	SealedContract: {
		DisplayName: 正式契约
		Tooltip:
			'''
			最大生命增加60
			治疗法术会额外治疗5点生命值
			使用光辉镰刀获得灵魂精华时，会获得一层充能
			牧师镰刀的弹幕或非镰刀类武器造成的光辉伤害会消耗充能，以获得灵魂精华
			“协议达成！”
			'''
	}

	Shellxophone: {
		DisplayName: 深海奥德赛
		Tooltip:
			'''
			左键释放两根弹跳并追踪敌怪的海渊涟漪
			右键释放追踪队友的水滴，使用10点灵感值并治疗队友
			治疗效果会根据队友的咒音增幅等级而增加
			“唤醒蛰伏渊洋的生灵，奏响世间至韵之声”
			'''
	}

	ShoulderBlade: {
		DisplayName: 肩骨刃
		Tooltip:
			'''
			投掷一把在一定距离停下的血肉飞斧
			停下时若击中目标，则召唤追踪的吸血箭
			'''
	}

	SierraChimera: {
		DisplayName: 至高嵌合体
		Tooltip:
			'''
			免疫[i:ThoriumRework/QueenJellyPin]泡泡，[i:ThoriumRework/VampireCape]流血和[i:ThoriumRework/VampireCape]吸血鬼之咒
			[i:ThoriumRework/QueenJellyPin] 在玩家身上召唤可以锁定敌人的触手，触手击中敌人后可提升生命再生与资源再生
			[i:ThoriumRework/QueenJellyPin] 触手的伤害会随着玩家防御提升
			[i:ThoriumRework/VampireCape] 激活血蝠群舞时，受到的伤害大幅降低，敌人不太可能以你为目标
			[i:ThoriumRework/ZephyrWings] 疾风钩的半空抓取效果可以延长飞行时间
			[i:ThoriumRework/ZephyrWings] 滑翔一段时间后，可以再次使用疾风钩，造成伤害可以缩短其冷却时间
			'''
	}

	SoulSnatcher: {
		DisplayName: 窃魂者
		Tooltip:
			'''
			该连枷被视为镰刀
			以刀刃命中敌人会生成灵魂精华
			以刀柄命中敌人会生成滞留的治疗能量
			同时最多可存在5团治疗能量
			“你的灵魂属于窃魂者！”
			'''
	}

	SpittingShroomStaff: {
		DisplayName: 胆小菇法杖
