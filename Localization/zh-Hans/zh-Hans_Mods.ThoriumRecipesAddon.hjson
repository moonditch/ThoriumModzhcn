Keybinds: {
	ShowAcquisitionInfo.DisplayName: 显示资讯
	OpenHintBook.DisplayName: 瑟银信息手册
}

ShopPreview: {
	ConditionsHeader: 商店状况:
	NewItemUnlocked: "{0}的商店解锁新物品: {1}"
}

ManualAcquisition: {
	WaterChestnut: 由深海生物群系自然生长的水元栗植物掉落获得
	ManaBerry: 从地表神圣草上的魔力浆果植物上采摘获得
	Heartstriker: 在丛林生物群系钓鱼获得
	ArcaneSpike: 无法获得
	EnchantedStaff: 从地下金箱获得
	SpittingFish: 在海洋生物群系钓鱼获得
	RogueRoninHeadband: 击败史莱姆王后，在旅商处 (33.3% 概率) 售卖获得
	NoteHairpin: 在旅商处售卖获得
	HatFish: 在白天的海洋生物群系钓鱼获得
	RingofUnity: 有概率从绯红箱中获取，也可在绯红匣中获得
	AloeLeaf: 有概率从地下丛林的大型叶类植物（环境物体）掉落获得
	HeartRateMonitor: 在旅商处售卖获得
	LivingWoodSap: 在生命树中的生命木箱获得，或者挖掘树液覆盖的生命之叶灌木获得
	SeedofHope: 在生命树中的生命木箱获得
	AbyssalWhistle: 地狱任何怪物都有概率掉落获得
	FishEgg: 挖掘大珊瑚（环境物体）时掉落获得
	ExoticMynaEgg: 用任意虫网捕捉八哥时获得
	MoleCrate: 在旅商处售卖获得
	ChiLantern: 击败邪恶BOSS后，在旅商处售卖获得
	DestinyWeaver: 无法获得
	TheGauntlet: 无法获得
	Fishbone: 在地牢的渊海箱中获得
	PharaohsSlab: 在地牢的沙漠箱中获得
	PhoenixStaff: 在地牢的地狱箱中获得
	AdventurersLantern: 从地下和洞穴层的帐篷（环境物体）获得
	BrainCoral: 在猩红生物群系或猩红地下钓鱼获得
	RivetingTadpole: 在丛林生物群系钓鱼获得
	SamsaraLotus: 击败邪恶BOSS后，在旅商处售卖获得
	RottenCod: 在腐化生物群系或腐化地下钓鱼获得
	PharaohsBreath: 沙漠生物群系以及地下沙漠任何怪物都有概率掉落获得
	SoulofPlight: 困难模式下地狱任何怪物都有概率掉落获得
	FlamingCrackGut: 在岩浆中钓鱼获得
	MagmaGill: 在岩浆中钓鱼获得
	UnholyShards: 血月期间任何怪物都有概率掉落获得
}

// Make sure the text doesn't extend beyond the UI. Check the terms against the mod's translation into your language
// $parentVal is the main tab category with subcategories
// Don't translate {i:ThoriumMod/ItemName}, instead of this key, the text displays the item

InfoBook: {
	GuideDialogue: 在玩瑟银? 看来你的品味不错，给你这本瑟银信息手册--里面记录着有关这个模组各种实用指南。
	UnlockNotification: 信息手册已解锁！使用“打开信息手册”的控键即可打开。
	GuideBubble: 过来，朋友!
}

HintBook: {
	NpcTooltips: {
		ThoriumMod_TheGrandThunderBird: 白天在沙漠使用[i:ThoriumMod/GrandFlareGun]发射[i:ThoriumMod/StormFlare]。
		ThoriumMod_QueenJellyfish: 白天靠近海洋使用[i:ThoriumMod/JellyfishResonator]召唤。
		ThoriumMod_GraniteEnergyStorm: 在花岗岩洞使用[i:ThoriumMod/UnstableCore]召唤Boss，如果区域内有不稳定的反常流能，不稳定核心不会生效。
		ThoriumMod_BoreanStrider: 在困难模式暴雪期间自然生成，也可以使用[i:ThoriumMod/StriderTear]召唤。
		ThoriumMod_FallenBeholder: 在地狱使用[i:ThoriumMod/VoidLens]召唤。
		ThoriumMod_Viscount: 在鲜血祭坛使用5个不洁碎晶召唤，[i:ThoriumMod/GrimPointer]可以指示鲜血密室的位置。
		ThoriumMod_PatchWerk: 缝合人会生成在血月期间，可以从迷途僵尸处购买[i:ThoriumMod/FreshBrain]再次进行召唤。
		ThoriumMod_CorpseBloom: 在克苏鲁之脑/世界吞噬怪被击败后它会生成在地下丛林附近，可以从迷途僵尸处购买[i:ThoriumMod/RottingSpore]再次进行召唤。
		ThoriumMod_Blacksmith: 击败{$NPCName.EyeofCthulhu}。
		ThoriumMod_Druid: 在骷髅王后的丛林击败绝命花。
		ThoriumMod_ConfusedZombie: 在血月期间击败缝合人。
		ThoriumMod_Diverman: 击败水母皇后。
		ThoriumMod_BuriedChampion: 大理石洞内使用[i:ThoriumMod/AncientBlade]召唤Boss或者打死埋葬石像（骷髅王后生成）。
		ThoriumMod_StarScouter: 在天空使用[i:ThoriumMod/StarCaller]召唤。
		ThoriumMod_Lich: 使用30个南瓜在自然墓地的远古护身符召唤。（三王后的夜晚）。
		ThoriumMod_ForgottenOne: 虚影潜游者会掉落[i:ThoriumMod/AbyssalShadow2]，拾取物品时，它会造成深渊幻影减益，深渊幻影减益叠加3次后，Boss生成（在深海）。
		ThoriumMod_Cobbler: 在你的物品栏中有鞋子饰品（[i/s1:Aglet][i/s1:HermesBoots][i/s1:RocketBoots][i/s1:WaterWalkingBoots]等）。
		ThoriumMod_Cook: 击败{$NPCName.KingSlime}。
		ThoriumMod_DesertAcolyte: 击败惊雷王鹰。
	}

	Title: 瑟银信息手册
	OpenButton: 打开信息手册
	DragHint: 按住鼠标右键拖拽
	MobList.Header: "{0} — {1} ({2})"

	Tabs: {
		Basics: 瑟银模组
		EarlyGame: 模组进度
		Progression: 机制
		Bestiary: 生物
		Tips: 贴士

		Classes: {
			$parentVal: 新职业
			Bard: 吟游诗人
			Healer: 牧师
			Thrower: 投手
		}
	}

	Basics: {
		P1: "{img:ThoriumLogo}"
		P2:
			'''
			瑟银是泰拉瑞亚最大的内容性模组之一，已开发超过 10 年。.
			它包含大量与泰拉瑞亚原版兼容的内容，包括: 约2900件物品，约200只NPC，3只迷你BOSS，11只BOSS，1个全新的生物群系，1个新建筑，以及大量兼容原版泰拉瑞亚的事件，生物群系等内容。
			通过这本信息手册，你无需阅读wiki即可了解该模组的基础知识 (尽管它并不能完全代替维基百科)。
			你还将找到我的个人游戏经验 (我已经通关约十次)。祝你游戏愉快!
			[c/00ff00:翻译来自作者的英文文案，推荐和与瑟银汉化组无关。]
			'''
	}

	EarlyGame: {
		P1:
			'''
			=====================================================
			在这份简易指南中，你可以快速了解应该在游戏中的哪些地点以及那个阶段去寻找新内容。
			=====================================================
			'''
		P2:
			'''
			[c/00ff00:游戏初期:]
			游戏刚开始时，你的物品栏中就有一件 {i:ThoriumMod/FamilyHeirloom}的传家宝。 
			现在这个物品毫无用处，只有在游戏后期可以制作成一件供你收藏的弱效武器。
			虽然物品描述中未提及，但它能提供1点防御力，因此在获得首个饰品之前，你可以先把它装备上。
			'''
		P3:
			'''
			瑟银模组对游戏初期几乎没有影响，你依然可以像在原版游戏中那样进行常规操作，而模组新增的内容会自然而然地出现在你的游戏进程中。
			值得一提的是 {i:ThoriumMod/ThoriumOre}瑟银矿和 {i:ThoriumMod/LifeQuartz}生命石英 — 是游戏初期的优质材料。 
			用瑟银矿可以在游戏初期做个不错的盔甲，以及{i:ThoriumMod/Crietz}精准项链，这个饰品甚至可以用到困难模式之后。
			'''
		P4:
			'''
			{npc:4}[c/00ff00:初期BOSS:]
			击败 {npc:ThoriumMod/TheGrandThunderBird}惊雷王鹰，{npc:4}克苏鲁之眼，{npc:50}史莱姆王，以及{npc:266}{npc:13}邪恶BOSS后，几位来自模组的城镇NPC会入住，并出售一些实用物品。
			例如，你可以从 {npc:ThoriumMod/Blacksmith}铁匠处购买 {i:ThoriumMod/ArcaneArmorFabricator}奥术盔甲锻铸台，这是一个制作站，你可以利用它在挑战邪恶Boss之前制作不错的装备。
			此外血月期间，迷你BOSS {npc:ThoriumMod/PatchWerk}缝合怪会生成，击败他可以掉落一个实用的 {i:ThoriumMod/SuspiciousMoisturizerBottle}手部宠物，它能指示稀有敌人的位置并会在你死亡时发生嘲笑。
			在哥布林入侵期间，你可以获得 {i:ThoriumMod/DarkGate}暗影之门，这也是一件实用且能陪你度过一段游戏进程的物品。
			'''
		P5:
			'''
			{npc:266}{npc:13}[c/00ff00:邪恶BOSS后:]
			击败邪恶BOSS后，你将解锁几个新BOSS和一个新的生物群系。
			地下丛林中，{npc:ThoriumMod/CorpseBloom}绝命花开始生成，击败后{npc:ThoriumMod/Druid}德鲁伊会入住，她会出售草药的种子。
			从{npc:ThoriumMod/ConfusedZombie}迷途僵尸处购买，{i:ThoriumMod/GrimPointer}恐怖指针，你可以找到 {link:https://thoriummod.wiki.gg/wiki/Blood_Chamber|鲜血密室} ，然后再 {link:https://thoriummod.wiki.gg/wiki/Blood_Altar|鲜血祭坛} 处，使用5个{i:ThoriumMod/UnholyShards}不洁碎晶，召唤{npc:ThoriumMod/Viscount}蝙蝠子爵。
			蝙蝠子爵会掉落相当不错的武器，总体来说，他是一个非常有趣的BOSS。（顺便说一句，他是这个模组里面我最喜欢的BOSS）
			在海洋中，你可以召唤 {npc:ThoriumMod/QueenJellyfish}水母皇后，她会掉落...... {npc:ThoriumMod/Diverman}潜水员NPC，他可以让你在新的生物群系中生存的更加轻松。
			对了，新的生物群系 — 你现在可以前往 {link:https://thoriummod.wiki.gg/wiki/Aquatic_Depths|深海} 了。
			它总是在丛林一侧的海洋下面生成，所以很容易找到他。 
			这个生物群系没什么重要的东西，除了可以查看宝箱的战利品，以及 {i:ThoriumMod/Aquaite}海洋矿，接下来骷髅王和蜂后等着你击败。
			'''
		P6:
			'''
			{npc:35}[c/00ff00:骷髅王后：]
			击败骷髅王后，通往地牢的道路便向你敞开。
			在地牢中，有几种新材料值得你关注，分别是{i:ThoriumMod/aDarksteelAlloy}暗钢锭与{i:ThoriumMod/SpiritDroplet}末灵。
			地牢宝箱中也有新的战利品，你可以去寻找它们。
			接下来是多达3个模组BOSS——{npc:ThoriumMod/GraniteEnergyStorm}花岗岩流能风暴，{npc:ThoriumMod/BuriedChampion}英灵遗骸和{npc:ThoriumMod/StarScouter}星际监察者。 
			花岗岩能量风暴没有很特殊的掉落物品，但在你制作困难模式翅膀之前，英灵遗骸会掉落不错的{i:ThoriumMod/ChampionWing}翅膀。
			星际监察者会为除牧师外的所有职业掉落相当不错的武器，有了它，肉墙就不会造成问题了。
			'''
		P7:
			'''
			{npc:113}[c/00ff00:欢迎来到困难模式：]
			好了，你进入了困难模式……从现在开始，瑟银的内容将变得更加丰富。 
			从世界频道中，你可能已经猜到深海出现了新的敌人。
			你应该去那里看看，那里出现了两种新的材料{i:ThoriumMod/DepthScale}深海之鳞和{i:ThoriumMod/AbyssalChitin}深渊角质鳞。
			但更重要的是{i:ThoriumMod/CrystalWave}水晶波痕。它的用途从物品描述中就已经很清楚了。。
			从困难模式一开始，它就会在深海中生长——只要破坏它，它就会掉落。下面是它的样子。
			别忘了也扔一个进微光，以获得永久升级。
			'''
		P8: "{img:Crystal_wave_world}"
		P9:
			'''
			除了深海之外，海盗入侵、血月、神圣之地、地狱、沙漠和邪恶生物群系中也有新内容等着你。
			它们各自都以新材料而值得注意，这些材料又可用于为某些职业制作入门装备。
			你要找的素材是：{i:ThoriumMod/UnfathomableFlesh}, {i:ThoriumMod/GreenDragonScale}, {i:ThoriumMod/SoulofPlight}, {i:ThoriumMod/PharaohsBreath}, {i:ThoriumMod/HallowedCharm}, 和{i:ThoriumMod/BloodCell}。
			看看你能用它们制作什么，然后制作你喜欢的任何东西。
			你也可以尝试击杀新的宝箱怪——{npc:ThoriumMod/SubmergedMimic}, {npc:ThoriumMod/HellBringerMimic}和{npc:ThoriumMod/MyceliumMimic}。它们可以自然生成，也可以使用钥匙召唤，类似于原版的光明钥匙和夜光钥匙。
			'''
		P10:
			'''
			{npc:ThoriumMod/FallenBeholder}[c/00ff00:肉后:]
			在打Boss之前，除了常规装备外，我建议你制作{i:ThoriumMod/DemosGuidanceItem}蒂莫之指引——它是一个宠物，会替代你的固定增益方块。
			你可以轻松地一直带着它直到游戏结束；在瑟银模组中，我不知道还有更有用的宠物。
			接下来是两个新 Boss：{npc:ThoriumMod/BoreanStrider}极地遁蛛和{npc:ThoriumMod/FallenBeholder}堕落注视者。两者都非常非常简单，不会让你卡关。
			极地遁蛛没有令人印象深刻的掉落物；击败它后，蜘蛛洞中会开始生成新敌怪，但它们的掉落物也不特别令人兴奋。
			不过，击败堕落注视者后，就有值得期待的东西了。首先，会出现两种新矿石——{i:ThoriumMod/LodeStoneChunk}地脉矿与{i:ThoriumMod/ValadiumChunk}虚金矿。 
			Boss 被击败后，它们会在地下交替生成（也就是说，第一次击杀生成一种矿石，第二次击杀生成另一种，之后循环往复）。
			挖取它们，看看你能制作什么。其次，{npc:ThoriumMod/ConfusedZombie}迷途僵尸开始出售新的实用物品和材料{i:ThoriumMod/VoidHeart}虚空之心，可以用它制作一个有趣的钩爪。
			堕落注视者本身会掉落不错的武器，以及一个可在游戏末期升级的坐骑。之后，你只要击败所有机械 Boss 就行了。
			'''
		P11:
			'''
			{npc:134}{npc:126}{npc:127}[c/00ff00:机械BOSS后:]
			击败全部三个机械 Boss 后，你就能获得几种新材料。
			首先，你需要通过制作{i:ThoriumMod/SoulForge}灵魂熔炉来升级你的熔炉，之后几乎所有瑟银物品都要在它上面制作。
			下面列出你可以制作的东西以及它们的用途：
			{i:ThoriumMod/SubspaceWings}亚空间飞翼——适合接下来 Boss 战的好翅膀。
			{i:ThoriumMod/TimeWarp}时间扭曲——如果你懒得用床跳过时间，而且你没装辅助类模组。
			{i:ThoriumMod/AirStrikeShield}空援卫盾——如果你只玩哨兵或玩多人模式，这是非常有用的物品。
			{i:ThoriumMod/WishingGlass}愿望魔镜——贝壳电话的升级版，附带额外传送。
			{i:ThoriumMod/AromaticBulb}芳香球茎——如果你找不到世纪之花球茎，用它的召唤物品会更方便。
			{i:ThoriumMod/TitanicBar}泰坦锭——一种材料。用它做的盔甲很垃圾，但武器值得一试。
			另外，机械 Boss 会给你掉落{i:ThoriumMod/StrangePlating}奇异电镀和{i:ThoriumMod/LifePoweredEnergyCell}生命能源晶电池。用前者可以制作一把在游戏剩余流程中非常有用——我甚至要说超模——的武器。它简直能碾压直到拜月教邪教徒为止的每一个 Boss。 
			第二种材料只对牧师有用。
			'''
		P12:
			'''
			接下来，你将不得不面对{npc:ThoriumMod/Lich}巫妖和{npc:262}世纪之花。
			巫妖可以通过在{i:ThoriumMod/AncientPhylactery}远古护身符上使用南瓜，在任何地方召唤。
			它位于地牢后面的{link:https://thoriummod.wiki.gg/wiki/Natural_Graveyard|墓地}，但你可以直接从{npc:ThoriumMod/ConfusedZombie}迷途僵尸处购买它，然后放置在任何地方。那样更方便。
			巫妖是一个非常简单的 Boss，但它会造成非常高的伤害，并且能在第二阶段恢复生命值。为了防止恢复，你需要击杀它定期生成的{npc:ThoriumMod/PhylacteryofaThousandSouls}万魂匣。
			对抗这个 Boss 时，避免接触伤害并拥有高 DPS 非常重要——这样你就出任何毛病。
			除了材料和武器外，巫妖还会掉落{i:ThoriumMod/Phylactery}魂匣（专家模式下），它可以放在时装栏中，在需要时切换使用。
			之后，你只需要击杀世纪之花——用{i:ThoriumMod/StrangePlating}奇异电镀制作的武器，这个 Boss 不算什么。
			'''
		P13:
			'''
			{npc:262}[c/00ff00:世纪之花后:]
			击败世纪之花后，{i:ThoriumMod/IllumiteChunk}就可以获得荧光矿了。荧光矿生成于洞穴层和地下层，而且只在首次击败世纪之花后生成——就像堕落注视者之后的虚金和地脉矿一样，后续击杀不会再生成。
			荧光矿用于制作平庸的射手盔甲和几把强度存疑的武器，但如果你喜欢可以试试。
			更让你感兴趣的应该是丛林神庙和地牢的变化。两者都有新敌人，会掉落新材料——神庙中的{i:ThoriumMod/SolarPebble}太阳石砾和地牢中的{i:ThoriumMod/DarkMatter暗物质。
			此外，你可以用灵气升级几种你已经熟悉的材料。自己查看制作配方吧。
			如果你是牧师，可以尝试刷圣骑士获取{i:ThoriumMod/HolyKnightsAlloy}圣骑士合金，它用于制作不错的盔甲。 
			你现在就可以出发去击杀新 Boss——{npc:ThoriumMod/ForgottenOne}遗忘之主。关于它没什么好说的：Boss 本身很简单，而它的掉落物，说得委婉点，不太有用——也许除了刷牧师盔甲和一根钓竿。 
			目前，我建议击杀猪龙鱼公爵获取{i:ThoriumMod/SoulAnchor}定魂锚。定魂锚是模组中最有用的物品之一，尤其是如果你对找护士治疗感到不适。
			原版事件（日食和各类月事件）也新增了一堆掉落物，所以如果你想，可以刷这些。之后，你就可以击杀石巨人。
			'''
		P14:
			'''
			{npc:439}[c/00ff00:月球领主后:]
			开发者在石巨人之后的内容上有点吝啬，所以你主要需要刷原版物品。 
			如果你的暴击率大约在 50–70%+，我强烈建议制作{i:ThoriumMod/MaskoftheCrystalEye}水晶之眼面具（这名字真蠢）。如果你有高暴击率，这个饰品大约能提升你 12–20% 的伤害，因为每次暴击造成 12% 额外伤害，并且还会使暴击率本身提高 8%。
			火星入侵（毫不意外）也有新掉落物，既有来自敌怪的，也有来自飞碟的，所以如果你想，可以刷它。
			之后，剩下的就是去打拜月教邪教徒了。
			'''
		P15:
			'''
			拜月教邪教徒会掉落新武器……3把法师武器，来自邪教徒。
			为什么？到底图什么？它甚至都不是 100% 掉落，而且邪教徒要等天界柱全死才会生成——所以你为什么要刷他？……
			总之，我把这一节拖得太长了，现在进入正题。
			获得远古操纵机后，你就能制作{i:ThoriumMod/TerrariumCore}元素核心。别被它们的配方吓到——你之前应该已经拥有所有材料，缺少的那些也不难获得。 
			用这些核心可以制作一套非常好的多职业盔甲，你可以穿着它对抗月亮领主。
			它们也用于为每个职业制作武器——是碎片武器的绝佳替代品。
			如果你没有刷猪龙鱼公爵或女皇的翅膀，你也可以制作{i:ThoriumMod/TerrariumWings}翅膀。
			{i:ThoriumMod/TerrariumParticleSprinters}元素粒子加速靴会明显提高你的移动速度，但当你已经有翅膀和坐骑时，你真的需要它吗？自己决定吧。 
			{i:ThoriumMod/TerrariumDefender}界元之庇佑，垃圾。不值得刷，而且对最后两个 Boss 完全没用，相信我。
			接下来，击杀天界柱并制作碎片武器，然后击杀月亮领主。
			'''
		P16:
			'''
			{npc:ThoriumMod/DreamEater}[c/FF0000:始][c/FF7D00:生][c/FFFF00:灾][c/00FF00:灵] [c/0000FF:与] [c/4B0082:噬][c/9400D3:梦][c/FF0000:者]
			现在最有趣的部分开始了……始生灾灵是瑟银里最难的 Boss……前提是你没听说过那颗传奇的星星！就是月亮领主掉落的那颗！它和翱翔徽章组合起来，能克制开发者为他们设计的所有攻击，轻轻松松！
			总之，来说这个 Boss。
			带上月亮领主后的装备是合理的——盔甲、武器、和谐杖、天界星盘。
			第一阶段没什么难的；你只需要水平横穿整个世界，远离所有三个始生灾灵；它们的攻击永远打不到你。
			唯一能追上你的是毁灭之灵，如果你犹豫并停下来就会被撞到，所以要小心。
			对抗潮汐之灵的龙卷风攻击时，一张透明全地图会帮到你；密切注意他的图标，当你看到他停下时，开始缓慢向上或向下飞——这就是你躲过那次攻击的方法。
			毁灭之灵还有一个非常简单的旋转球攻击。关键在于，它们总是朝着最终要飞去的方向旋转，所以趁它们旋转时，你可以轻松预判该往哪边飞。
			真正的乐趣从第二阶段的噬梦者开始。
			你仍然可以绕着世界飞，但这次你无法预判龙卷风，因为噬梦者会使用几种不同的攻击。
			还有一个非常恶心的传送加环形移动攻击，就我个人而言，我仍然不知道怎么应对。
			一般来说，如果他传送到你身后，你可以等他飞到你相对的另一侧，然后猛地转身往另一个方向飞。
			在这场战斗中防御非常重要，因为他们的伤害和造成的减益简直是恐怖化身。
			如果你被施加了减益，最好的办法是立刻通过装备并瞬间卸下十字章护盾或{i:ThoriumMod/MantleoftheProtector}守护者披风来清除它们（单独来看，这些饰品并不能覆盖 Boss 的所有减益，但组合起来就能让你完全无视 Boss 的减益）。
			别忘了{i:ThoriumMod/SoulAnchor}定魂锚，它每场战斗能有一次治疗你的机会。
			击败这个 Boss 后，瑟银就算通关了，剩下的就是用掉落的精华制作物品。为了收集。 
			=====================================================
			感谢阅读这个指南书，我因为懒拖了 3 天才写完。拜拜。
			'''
	}

	Bestiary: {
		DropsHeader: 掉落：
		NoDrops: (no)
		MoreDrops: …and {0} more
		HP: HP: {0}
		DMG: DMG: {0}
		DEF: DEF: {0}
		P1: "{moblist:ThoriumMod}"
	}

	Progression: {
		P1: 本节涵盖了该模组中所有值得注意的机制
		P2:
			'''
			[c/00ff00:免死:]
			免死是瑟银模组添加的一种机制。
			正常情况下，当玩家的生命值降至 0 时，他们会死亡并在短暂延迟后重生。
			模组中的各种物品可以阻止、撤销或延迟这一过程的发生，给玩家第二次存活的机会。
			阻止、复活和延迟是该机制目前可以采取的形式。
			[c/808080:阻止] 
			会阻止玩家受到致命伤害，在大多数情况下会治疗他们一定量生命值，并赋予他们短暂的无敌。以下所有来源都会施加一个共同的减益，防止多种死亡预防手段叠加使用。
			[c/808080:复活] 
			会让已死亡的玩家复活，使他们能够继续战斗。
			[c/808080:延迟] 
			让玩家免疫伤害，并在设定时间内阻止他们立即死亡。持续时间结束后，无论其生命值如何，玩家都会像原本那样死亡。
			'''
		P3:
			'''
			[c/00ff00:生命护盾：]
			生命护盾是瑟银模组添加的一种机制。
			它提供临时的最大生命值提升，其数值因来源而异。
			该效果可以通过连续施加护盾来叠加，直到达到指定上限，并会随着时间自然衰减。
			只要生命护盾处于激活状态，玩家心形生命值周围就会出现一圈蓝色边框。
			基本上，生命护盾就是一种纯粹的生命值提升，却不知为何被硬生生做成了一个独立机制……
			'''
		P4:
			'''
			[c/00ff00:化形：]
			化形是一种特殊物品，使用后可以将玩家变成某些生物或敌人。
			变身后，玩家无法使用任何物品，除了灵魂链接，它赋予化形特殊能力。
			大多数化形会缩小玩家的体型，使他们能够穿过更小的缝隙。
			变形物品可以放入坐骑装备栏，因此当玩家骑乘坐骑或已经化形时，无法使用它们。
			'''
		P5:
			'''
			[c/00ff00:脱战：]
			脱战是瑟银模组添加的一种机制。
			各类物品仅在玩家处于“战斗中”或“脱战”时生效。
			如果玩家在过去 5 秒内伤害过敌人，或被敌人伤害过，则视为处于“战斗中”。
			在整整 5 秒内既没有伤害敌人，也没有受到敌人伤害后，玩家将被视为处于“脱战”。
			'''
	}

	Classes: {
		P1: 瑟银新增了三个职业：吟游诗人，牧师与投手
		P2: 你可以在这里查看所有{link:https://thoriummod.wiki.gg/wiki/Guide:Class_setups|职业流程}，但我个人建议你不要盲目遵循维基指南——相反，你应该自己寻找装备，并构建自己的玩法。  

		Bard: {
			P1: 吟游诗人使用灵感来提升队伍的属性。他的乐器可以为附近的队友提供增益效果。
			P2:
				'''
				[c/00ff00:了解你的定位：]
				作为吟游诗人，你的玩法与射手或法师等职业并没有显著不同。
				会让你把注意力从伤害敌人和 Boss 上转移开的主要机制，就是吟游诗人的咒音增幅。
				咒音增幅是强大的增益，当使用乐器时会施加给吟游诗人及其附近的盟友。
				吟游诗人的大部分力量都来自这些增益，它们能带来更好的伤害、防御、移动和资源消耗。
				作为吟游诗人，你会想同时携带多种乐器，以获得更广泛的咒音增幅选项。
				如果你或你的队伍在移动，使用打击乐器来提高你的机动性。
				如果你在安全地伤害敌人，使用铜管乐器来提高你或你队伍的伤害潜力。
				如果你或你的队伍陷入冗长的战斗和 Boss 战中，使用弦乐器和管乐器来提高你的生存能力和资源管理。
				'''
			P3:
				'''
				[c/00ff00:咒音增幅：]
				咒音增幅是临时的属性提升，吟游诗人在使用乐器武器时会持续为自己和附近的盟友提供。
				作为该职业的标志性特色之一，许多吟游诗人物品都与咒音增幅的施加或强度有关。
				鼓舞分为 4 类，由特定的乐器类型提供，一般规则如下：

				铜管乐器 -> 伤害类咒音增幅
				弦乐器 -> 防御类咒音增幅
				打击乐器 -> 移动类咒音增幅
				管乐器 -> 资源类咒音增幅

				电子乐器独特之处在于，它自身不提供任何属性提升类的咒音增幅，而是延长玩家当前激活的任何咒音增幅的持续时间。
				'''
			P4:
				'''
				[c/00ff00:灵感值：]
				吟游诗人武器不使用法力，而是消耗一种名为灵感的独特资源，这种资源可以通过使用{i:ThoriumMod/InspirationFragment}灵感碎片、{i:ThoriumMod/InspirationShard}灵感碎块和{i:ThoriumMod/InspirationCrystalNew}灵感水晶提升。
				灵感会自动回复。尽管许多吟游诗人物品都专门围绕灵感设计，但它独立于法力这一点，使它成为其他职业备用选择的诱人之处。
				如果让灵感自然回复而不打断，它的回复速度会快得多，这鼓励玩家为这种资源安排一段类似“装填”的间隔。
				'''
			P5:
				'''
				[c/00ff00:大型乐器：]
				大型乐器是吟游诗人武器的一个子集，使用一种计时器机制。
				当被持有时，玩家下方会出现一个计时器（如果配置设置“将乐器计时器移到光标”设为 是，则会出现在光标下方）；乐器的效果取决于其攻击是否在特定的时间窗口内使用。
				随着玩家成功把握攻击时机，大型乐器会获得威力、提供鼓舞等级以及其他效果，而错过时机则会大幅降低这些加成。
				'''
		}

		Healer: {
			P1: 牧师专注于治疗队友并施加防御增益效果。
			P2:
				'''
				[c/00ff00:职业背景：]
				在泰拉瑞亚中，死亡是玩家唯一可能遭遇的重大挫折，它发生在玩家在移动或判断上犯下多次错误之后。
				在原版中，这些错误只能通过少数有限的方式来弥补，例如治疗药水、护士、敌人掉落的心，以及在游戏后期很晚才出现的吸血装备。
				然而，作为牧师，玩家拥有独特的能力，可以随意“撤销”这些错误，并为可能缺乏技巧或防御装备的队伍做出贡献。
				然而，这种能力是有代价的。大多数治疗师装备会降低近战、远程、魔法、召唤、投掷和音波武器的有效伤害。
				这些伤害降低会严重影响玩家的 DPS 潜力，并用于平衡治疗和保护队友的极强能力。不过，牧师有自己的一套武器，这些武器会因其装备而得到强化，并在他们觉得反击敌人最符合自身利益时，作为自卫手段。
				这些武器拥有自己独特的伤害类型，称为“光辉伤害”，并且通常带有与治疗或支援盟友相关的次要效果。
				以 药丸 这样的武器为例，它的左键允许玩家伤害敌人，右键则允许他们暂时提高盟友的生命恢复。
				大多数（如果不是全部）光辉武器都具有类似的能力，既能支援盟友，同时又能伤害敌人。
				'''
			P3:
				'''
				[c/00ff00:了解你的定位：]
				作为牧师，首要目标当然是治疗盟友并防止他们死亡，这一点应该不会让人意外。
				你可以通过治疗法术、支援法术，以及某些情况下的光辉武器，用许多方式来实现这一点。
				需要维持和追踪的内容之多，让牧师成为一个非常刺激且回报丰厚的职业。
				话虽如此，牧师应该不断观察战斗进展，并相应地改变行动。
				由于战局随时可能变化，决定什么才是更紧迫的事情取决于治疗师自己，但牧师的一个非常基本的优先级列表如下。

				降低仇恨 >> 治疗队友 > 布置支援 > 伤害敌人

				别让仇恨落在你身上，牧师们！
				[c/808080:降低仇恨：] 
				死掉的牧师就是没用的牧师（大多数情况下），所以让敌人不再追着你，并正确地转去攻击另一名队友，应该是你首要且持续的目标。你有能力治疗承接仇恨的队友，而他们没有，所以远离伤害是首要任务。这并不意味着你在试图甩掉他们时“什么都不做”，但在持续受压时四处移动，这始终应该是你的目标。

				[c/808080:治疗队友：] 
				始终让队友的生命值保持在健康水平。你应该了解每位队友的承伤能力，优先治疗防御低或持续承受仇恨而受伤的队友。一般来说，如果法力允许，目标就是让玩家的生命值保持在接近最大值。但当情况变得混乱，尤其是在入侵和 Boss 战中，你只有几秒钟来决定谁比其他人更有死亡危险。所以把一名队友奶满可能不是最聪明的做法，转而进行一些分散治疗，让多名队友远离死亡，会是更好的选择。

				[c/808080:布置支援：] 
				有许多支援物品不会直接治疗队友，但仍有助于保护他们。伤害减免、生命护盾、生命恢复、持续治疗效果等需要时间准备，但当危险骤增时能挽救生命。在战斗中的空闲时刻，治疗师可以准备或施加支援能力，以便更好地为某个阶段或即将到来的危险攻击做准备。如果你的队友相当健康，而你最近没有刷新支援效果，那么把它们布置好可能是明智之举。

				[c/808080:伤害敌人：]
				如果你没有立刻面临危险，队友生命值处于可接受水平，且你的支援法术还有不少持续时间，那么就是时候开始为团队出力了。你的光辉武器提供了一种在造成一些伤害的同时仍能提供支援效果的方式，以防情况再次变糟。只是务必不要用光辉法术耗尽所有法力；如果队友再次开始受到大量伤害，你可能会缺少救他们所需的法力。
				'''
			P4:
				'''
				[c/00ff00:机制：]
				牧师职业拥有多种独特的机制，这些机制与其成功息息相关。

				[c/808080:额外治疗量：]
				大多数治疗来源会按照其工具提示中所述的基础量进行治疗。一些物品会为持有者提供额外的治疗能力，使他们能够提高治疗输出。通常这些治疗加成无法作用于持有这些物品的施法玩家自身，但通过诸如圣辉法杖、闪星和新生之类的法术，玩家可以与盟友一起获得这些加成。饮用魔力药水后受到的魔力疾病也会使玩家陷入“脱离联系”状态，从而抵消额外治疗。这种负面效果鼓励治疗师更好地管理魔力消耗，并惩罚那些试图滥用魔力药水的治疗师。

				[c/808080:生命恢复：]
				生命恢复是一种特殊的治疗形式，其作用相当于持续治疗增益。它与生命再生分开运作，即使因流血等效果导致生命再生无法生效，它仍会继续生效。恢复速率不受移动、受到伤害、造成伤害或除其计时器以外的任何因素影响。每秒钟，除非处于快速恢复增益效果下，玩家将恢复等同于其生命恢复数值的生命值。牧师提供的所有形式的生命恢复都来自饰品效果，并作为增益作用于被治疗的队友。

				由于生命恢复效果只需触发一次即可施加并持续其完整持续时间，因此在牧师可能失去治疗目标视线的情况下效果很好。它在持久战中也表现出色，因为在这类战斗中，持续治疗比爆发治疗更重要。影响大量队友的治疗法术与生命恢复效果配合得也极其出色，因为它们可以通过一次施放触发大量生命恢复周期。

				[c/808080:生命护盾：]
				最大生命值和最大生命护盾条。
				生命护盾是一种会衰减的、临时提高玩家最大生命值的效果。受到伤害时，会先扣除生命护盾，然后才真正影响你的生命值。本质上，它相当于一个缓冲，抵御接下来对你的攻击。许多治疗物品和支援法术会提供生命护盾，不过其他物品和效果也可以提供。它不占用增益栏位，因此能够拥有额外 25/50 最大生命值是一种极其强大的效果。玩家的屏障每秒会衰减 1 点，直到不再有屏障生命。

				[c/808080:光环：]
				光环是激活后围绕持有者光标的各种大小的临时圆环。它们会对任何触碰光环的队友施加增益效果，但不会使施法者本人受益。这些光环无需持续引导，只需使用一次就能持续相当长的时间。使用选定的光环一次后，牧师就可以切换到他们认为需要的任何治疗法术或武器，同时仍然对触碰到的队友施加特殊效果。光环让牧师能够以极少的精力和维持成本，被动地提高队伍的伤害和生存能力。

				[c/808080:治疗连击：]
				看来某人知道自己在做什么。
				治疗连击主要是一种信息显示功能，用于显示治疗师在一定时间内完成的治疗量。在连续三秒没有为治疗连击做出贡献后，治疗师头顶会出现一个巨大的绿色数字，显示该连击期间的总治疗量，并标志着连击结束。目前，有三种行为会积累治疗连击：

				治疗玩家：通过诸如好人书或圣辉法杖之类的治疗法术，直接治疗盟友玩家或施法者自身。

				减轻伤害：通过远古庇护和保护法杖等物品，减少盟友受到的伤害。

				窃取生命：使用诸如汲血牙和鲜血转移之类的光辉武器窃取敌人生命。

				[c/808080:光辉伤害]
				除了牧师职业新增的治疗能力外，一个新的伤害类型光辉伤害也应运而生。他们可以通过牧师盔甲、饰品、物品，甚至一种增益药水来提高光辉伤害。光辉武器具有特殊的次要效果，可以支援盟友，在某些情况下甚至能支援治疗师自身。光辉武器被分为三个未列出的子类别：

				光明光辉：帮助治疗盟友或施法者的武器。这种治疗可以是直接治疗、持续治疗，或留滞留的供他人拾取的治疗。

				腐化光辉：窃取或消耗生命的武器。它们通过将施法者的一部分生命转移给附近受伤的队友，或窃取敌人生命来支援队友。

				温和光辉：诸如镰刀之类的武器，不属于其他两个类别。它们通常不提供次要支援效果，作用更像传统武器。
				'''
		}

		Thrower: {
			P1: 在原版泰拉瑞亚1.4更新中移除投手职业后，瑟银模组将该职业独立化并加以扩展。
			P2:
				'''
				[c/00ff00:机制：]
				[c/808080:秘技卷轴]
				秘技卷轴是使用后允许玩家执行特殊能力的物品，其类型取决于最后使用的秘技卷轴。例如，秘技卷轴：暗影之舞允许玩家传送到光标位置。这些秘技卷轴会消耗玩家的技巧值，技巧值会在造成投掷伤害时自动回复。

				[c/808080:投掷疲劳]
				使用非消耗性投掷武器时，例如高斯掷能匕或剪刀狂人的手剪，疲劳槽会开始填充。
				如果疲劳槽满，玩家会受到20秒的疲惫减益惩罚。
				当玩家拥有此减益时，每次使用非消耗性投手武器后伤害会降低 20% ，直到最后造成 1 点伤害。
				使用非消耗性投手武器击杀敌怪时会补充 10% 最大疲惫值。
				基础疲惫值上限为 1200（拥有水壶时为 1680，拥有美人鱼水壶时为 1920，二者都有时为 2400）。 
				每次使用非消耗性投手武器时，使用时间的 2 倍会被计入疲惫值。
				每秒钟，无论玩家在此期间使用什么武器都会恢复 60 疲惫值，除非玩家拥有疲惫减益。
				当减益激活时，在此期间不会恢复疲惫值。
				如果减益消失，玩家会立刻恢复所有疲惫值。
				'''
		}
	}

	Tips: {
		P1: 在这里，你会找到我（Thorium Info+ 的开发者）关于游玩瑟银的个人建议。我只强调了最值得你注意的最重要的事情。
		P2:
			'''
			[c/00ff00:不要忽视城镇NPC]
			在瑟银中，几乎所有城镇 NPC 在游戏中都有目的和意义——他们并非无缘无故被加入模组（尽管并非所有 NPC 都是如此）。
			例如，鞋匠{npc:ThoriumMod/Cobbler}可以在早期给你免费移动速度提升，并让制作泰拉闪耀靴更容易。
			德鲁伊{npc:ThoriumMod/Druid}让药水制作更容易。
			迷途僵尸{npc:ThoriumMod/ConfusedZombie}出售一些 Boss 的召唤物品，让你可以刷它们赚钱。
			潜水员{npc:ThoriumMod/Diverman}让你在深海中的停留更容易。
			铁匠{npc:ThoriumMod/Blacksmith}出售一个制作站，你可以使用它为邪恶 Boss 制作好装备。
			厨师{npc:ThoriumMod/Cook}出售可作为额外治疗物品的食物。
			沙漠侍僧{npc:ThoriumMod/DesertAcolyte}可以召唤沙尘暴。
			'''
		P3:
			'''
			[c/00ff00:不要忽视防御]
			在原版中，防御远比伤害更可取，尽管很多人直接忽视了这一点。
			然而，瑟银把这一点发挥到了极致。
			瑟银中的防御极度不平衡——通过组建防御配装，你简直会变得杀不死。
			下面是我与月亮领主 Boss 战的截图，我当时只是全程站着不动吸收伤害，同时玩的是纯哨兵。
			'''
		P4: "{img:TrashDef}"
		P5:
			'''
			最后一条重要提示：[c/00ff00:做赏金猎人的任务] 
			完成赏金猎人一些相当简单的契约，他就会会开始出售相当有用的物品。
			例如，普通宝箱怪的召唤物品、通往地牢的传送器等等。
			由此引出一条简短的附加提示：[c/00ff00:收集并保存征服者勋章]以购买重要物品。
			'''
	}
}

BestiaryIntro: {
	Message: Bestiary entry for '{0}': {1}
	Message_Boss: Bestiary entry for '{0}': {1}
}

// Don't touch Divider, there was a stripe there before, but I decided to remove it
ArmorSetBonus: {
	Header: 套装奖励:
	Divider: ""
}

// Check the set bonuses against their translations in the game in your language to avoid any discrepancies
ManualSetBonus: {
	Silk: 高于 90% 最大魔力时 +25% 魔法伤害
	LivingWood: 生命木橡子的攻击会追踪敌怪
	SandStone: 沙漠之风为你提供了沙质二段跳
	Icy: 一个寒冰光环环绕着你，冻结待在其内太长时间的敌怪
	Steel: +8% 伤害减免
	Thorium: +10% 伤害
	Flight: 你可以短暂飞行
	Granite: 免疫击退，火块，熔岩和着火了！，-50% 移动速度且最大奔跑速度有上限
	Ebon: 腐化你的光辉能量，使它们呈现黑暗形态并造成额外效果
	NoviceCleric:
		'''
		每5秒你会生成至多3个神圣十字架
		在使用治疗法术时会消耗1个十字架而不是魔力
		'''
	Coral:
		'''
		增加1点光辉伤害
		光辉伤害会建立至多20点生命护盾且你的生命护盾不会随时间衰减
		治疗队友会将生命护盾转移到他们身上
		'''
	YewWood:
		'''
		四次非暴击打击后，你的下次远程攻击会小暴击造成150%伤害
		小暴击会触发暴击相关的效果
		'''
	Flesh:
		'''
		受伤时伤害敌怪有10%概率掉落肉
		收集肉会恢复生命并获得伤害加成
		'''
	TideHunter: 远程暴击会释放一堆泡沫，减速附近敌怪
	DepthDiver: 你和附近的队友会获得10%伤害提升，10%移动速度且可以在水下呼吸
	NagaSkin: 每消耗75魔力会短暂地大幅增加你的魔法伤害和施法速度
	Criers: 你的音波咒音增幅会额外持续 3 秒
	Nobles: 灵感音符的潜能翻倍并短暂增加你的音波伤害
	Jesters: 音波暴击会在你头顶响起一个铃铛，短暂减速附近所有敌怪
	Jesters2: 音波暴击会在你头顶响起一个铃铛，短暂减速附近所有敌怪
	Cryomancer: 魔法伤害会冻结敌怪两秒
	Astro: 召唤伤害击中时有概率释放一道伤害性的爆炸脉冲
	Geode: 你现在可以一次挖掘整个矿脉
	Illumite: 你的弓，枪和发射器会定期发射额外弹幕
	Blooming: 你的治疗法术会增加被治疗目标的生命恢复和生命恢复速率
	SpiritTrapper:
		'''
		增加 1 个最大哨兵
		击杀敌怪或持续伤害Boss会生成灵魂微粒
		生成5个微粒后，它们会被立刻消耗并治疗你10点生命值
		'''
	LifeBloom:
		'''
		仆从和哨兵攻击击中时有25%概率治疗你
		10秒内你无法治疗超过50点生命值
		'''
	Dread:
		'''
		你的靴子以不真实的频率振动，大幅增加基础移动速度
		移动时，你的近战伤害和暴击率增加
		'''
	Valadium: 按下▲上键翻转重力。翻转时，远程伤害增加15%
	Lodestone:
		'''
		敌怪更有可能瞄准你
		每失去25%生命值增加6%伤害减免
		低于25%生命值时伤害减免到达最大18%
		'''
	Titan: 造成的伤害增加18%
	Dragon: 攻击有概率释放龙焰爆炸
	DemonBlood: +100 最大生命
	TideTurner:
		'''
		按下盔甲能力键会将你包裹在密不透风的泡泡中
		将所有受到的伤害转化为治疗
		'''
	Darksteel: 没有什么能阻挡你的移动！双击来冲刺！
	Durasteel: +10% 伤害减免
	WhiteKnight:
		'''
		你消耗魔力的40%会存储为能量，上限400
		按下盔甲能力键会消耗存储的能量回复至多200魔力和20生命
		'''
	HallowedBard:
		'''
		击中敌怪后进入免疫状态
		增加8秒你音波咒音增幅的持续时间
		'''
	HallowedHealer:
		'''
		击中敌怪后进入免疫状态
		治疗法术会额外治疗6点生命值
		'''
	BioTech:
		'''
		一个生物工程探测器会协助你治疗队友
		治疗队友等同于你治疗加成的生命值
		'''
	Warlock:
		'''
		光辉攻击会生成至多15颗暗影微粒
		按下盔甲能力键会向光标位置释放所有存储的暗影微粒
		'''
	FallenPaladin: 受到伤害会治疗附近队友所受伤害15%的生命值
	Iridescent:
		'''
		你的光辉伤害有15%概率释放一道致盲闪光
		闪光会以你的治疗加成治疗所有附近队友并困惑敌怪
		'''
	LifeBinder: 治疗法术会短暂增加被治疗玩家50点最大生命值
	Sacred: 治疗法术会额外治疗5点生命值
	Templar: 如果队友生命值低于一半，你会获得治疗能力提升
	DreamWeaverHelmet:
		'''
		按下“盔甲能力”键会消耗200魔力并扭曲现实结构
		敌怪会被大幅减速且受到所有来源的伤害增加15%
		队友会大幅增加移动速度和攻击速度，并将到来的非致命伤害转化为治疗
		'''
	DreamWeaverHood:
		'''
		按下“盔甲能力”键会消耗200魔力并将你放置在梦中
		在梦中时，被治疗的队友会变得短暂无敌且所有减益都会被治愈
		'''
	Whispering:
		'''
		你会偶尔产生一根深渊能量触手攻击附近敌怪
		你可以拥有至多6根触手且它们的伤害会从被击中的敌怪吸取1点生命和魔力
		'''
	Celestial:
		'''
		按下盔甲能力键会消耗150魔力在你的光标周围召唤一个大型光环
		光环接触的队友会获得伤害，伤害减免，防御和生命恢复的提升
		光环接触的敌怪会受到神圣之怒且受到所有来源的伤害增加15%
		'''
	Conduit:
		'''
		不断移动会生成至多5个静态环，每个都会为你添加生命护盾
		满充能时，一个能量泡泡会保护你免受一次攻击
		'''
	Pyromancer: 你的魔法伤害会造成严重烧伤并伤害所有附近敌怪
	Terrarium:
		'''
		当你在战斗中时泰拉瑞亚的能量会追寻并保护你
		按下“盔甲能力”键在一系列职业“专注”中循环切换
		'''
	ShootingStar:
		'''
		增加6秒音波咒音增幅持续时间
		你拥有的每个独特咒音增幅会增加5%音波伤害
		你拥有的每个独特咒音增幅会增加2%灵感值再生
		'''
	MarchingBand: 战斗中，一个伤害性的彩虹音波符号会跟随你的移动并晕眩敌怪
	Ornate:
		'''
		音波暴击会使当前激活的一个随机咒音增幅提升到第四级
		此效果只能每5秒触发一次
		'''
	Maestro:
		'''
		按下盔甲能力键会召唤一个演奏音乐的鬼魂合唱团
		鬼魂会快速用铜管，管，弦和打击乐器造成伤害
		'''
	CyberPunk:
		'''
		按下盔甲能力键会让你在以下四种状态间循环：
		红 - 你和附近队友获得固定伤害 II 和伤害 II
		绿 - 你和附近队友获得移动速度 II 和飞行时间 II
		紫 - 你和附近队友获得资源上限 II 和资源再生 II
		蓝 - 你和附近队友获得防御 II 和伤害减免 II
		'''
	Inspirator:
		'''
		按下盔甲能力键会用每种III级咒音增幅过载所有附近队友15秒
		使用此能力需要20点灵感值且必须重新充能1分钟
		'''
	Soloist:
		'''
		按下盔甲能力键会让你获得无限的灵感值，大幅增加音波伤害和演奏速度
		此效果持续10秒并需要重新充能1分钟
		'''
	MasterArbalest: 你的伤害有10%概率完全复制自身并多造成15%伤害
	MasterMarksman:
		'''
		你的远程伤害有5%概率完全湮灭击中的目标
		此效果只能在Boss生命值低于5%时生效
		'''
	MagmaSeer: 所有召唤伤害会滞留下造成大量伤害的灼烧
	Bronze: 投掷伤害有20%概率释放一道穿透性闪电
	SpiritTrapper2:
		'''
		最大仆从数量增加1
		击杀敌怪或持续伤害Boss会生成灵魂微粒
		生成5个微粒后，它们会被立刻消耗并治疗你10点生命值
		'''
	Fungus:
		'''
		对受真菌感染的敌怪造成的伤害增加10%
		对受真菌感染的敌怪造成伤害会短暂增加10%投掷速度
		'''
	PlagueDoctors: 你的瘟疫云在空中的滞留时间翻倍且你的瘟疫连锁反应多造成20%伤害
	HallowedThrower:
		'''
		击中敌怪后进入免疫状态
		增加2点最大技巧值
		'''
	Lich:
		'''
		击杀敌怪会释放一道灵魂碎片
		接触灵魂碎片会短暂地大幅增加你的移动速度和投掷速度
		'''
	WhiteDwarf:
		'''
		暴击会从星宇释放象牙状火焰
		象牙状火焰会造成被击中目标0.1%生命值的伤害
		'''
	TideTurner2: 投掷伤害有20%概率在你周围释放追踪海潮飞刀
	ShadeMaster: 你所受伤害的50%会束缚在接下来的10秒内
}

