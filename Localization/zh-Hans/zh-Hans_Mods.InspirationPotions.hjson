Buffs: {
	InspirationWeakness: {
		DisplayName: 艺术瓶颈
		Description: 减少{0}%音波伤害
	}
}

Items: {
	InspirationFlower: {
		DisplayName: 灵感簧舌
		Tooltip:
			'''
			增加8%的音波伤害
			需要时自动使用灵感药水
			'''
	}

	LesserInspirationPotion.DisplayName: 弱效灵感药水
	InspirationPotion.DisplayName: 灵感药水
	GreaterInspirationPotion.DisplayName: 强效灵感药水
	SuperInspirationPotion.DisplayName: 超级灵感药水
	SupremeInspirationPotion.DisplayName: 至尊灵感药水
	DecorativeGreaterInspirationPotion.DisplayName: 装饰用强效灵感药水
	DecorativeInspirationPotion.DisplayName: 装饰用灵感药水
	DecorativeLesserInspirationPotion.DisplayName: 装饰用弱效灵感药水
	DecorativeSuperInspirationPotion.DisplayName: 装饰用超级灵感药水
	DecorativeSupremeInspirationPotion.DisplayName: 装饰用至尊灵感药水
}

PotionTooltip: 恢复 {0} 灵感值
Keybinds.QuickInspiration.DisplayName: 快速灵感

Configs: {
	InspirationPotionsConfig: {
		DisplayName: 共享设置

		CrateDrops: {
			Label: 宝匣掉落
			Tooltip: 让该模组影响到的钓鱼宝匣的掉落
		}
	}

	InspirationPotionsClientConfig: {
		DisplayName: 客户端设置

		DungeonBottles: {
			Label: 地牢药瓶
			Tooltip: 是否将灵感药水在世界的生成过程中，在地牢生成
		}
	}

	CrateLoot: {
		Tooltip: 箱子中的战利品

		Mixed: {
			Label: 融合
			Tooltip:
				'''
				灵感值药水和其他药水获取概率相同
				严格来说，这会降低其他掉落物出现的概率，因为它们被增加到了同一种权重。
				'''
		}

		Separate: {
			Label: 分离
			Tooltip: 灵感药水有的概率（1/8）从箱子中获取，其他药水的掉落保持不变。
		}

		None: {
			Label: 删除
			Tooltip: 灵感药水不可以在箱子获取
		}
	}
}
