Items: {
	ThoriumWhip: {
		DisplayName: 瑟银鞭
		Tooltip:
			'''
			{$CommonItemTooltip.SummonTagDamage}
			增加6%召唤暴击率
			召唤物将集中攻击被标记的敌人
			“由独特材料锻造的独特鞭子！”
			'''
	}

	RoyalTentacleWhip: {
		DisplayName: 皇家触手
		Tooltip:
			'''
			命中时有33%的概率召唤一只随机水母，持续3秒
			再次命中会刷新当前水母的持续时间
			                     “还湿着呢……”
			'''
	}

	RoyalTentacle: {
		DisplayName: 皇家触手
		Tooltip: 
			'''
			命中时有33%的概率召唤一只随机水母，持续3秒
			再次命中会刷新当前水母的持续时间
			                     “还湿着呢……”
			'''
	}
}

