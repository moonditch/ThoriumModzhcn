Buffs: {
	AcidReflux: {
		DisplayName: Acid Reflux
		Description: +5% damage and +5 armor penetration
	}

	GourdGuarded: {
		DisplayName: Gourd Guarded
		Description: +5 defense
	}

	HandShieldCooldown: {
		DisplayName: Hand Shield Cooldown
		Description: Can't catch them hands for a while...
	}

	InkLeaking: {
		DisplayName: Ink Leaking
		Description: Your instruments are leaking ink!
	}

	OrroBoroLeechCooldown: {
		DisplayName: Leech Swarm Cooldown
		Description: No Leeches?
	}

	Ulcer: {
		DisplayName: Ulcer
		Description: It Burns!
	}

	SerSemisonic: {
		DisplayName: Ser Semisonic
		Description: Lavender Town Syndrome
	}

	SerSemisonicCooldown: {
		DisplayName: Ser Semisonic Cooldown
		Description: He is missing, no?
	}
}

WhisperingHood: {
	RotGourd: Nothing but a mere shell of its former self...
	SpookySpirit: Oops! Party time's over!
	Moco: It's even allergic to its own existence...
	Daffodil: Good. Keep sleeping...
	OrroBoro: Their gluttony disgusts me...
	BigBone: Let's not get overprotective, shall we?
}

Configs: {
	BalanceConfig: {
		DisplayName: Balance Settings

		thrower: {
			Label: Throwing weapons damage multiplier
			Tooltip:
				'''
				Damage multiplier for throwing weapons
				(World restart required for this to take effect!)
				'''
		}

		bard: {
			Label: Bard weapons damage multiplier
			Tooltip:
				'''
				Damage multiplier for bard weapons
				(World restart required for this to take effect!)
				'''
		}

		radiant: {
			Label: Radiant weapons damage multiplier
			Tooltip:
				'''
				Damage multiplier for offense healer weapons
				(World restart required for this to take effect!)
				'''
		}

		soulEssence: {
			Label: Soul essence multiplier
			Tooltip:
				'''
				Granted soul essence multiplier for offense healer weapons
				Capped at 5
				(World restart required for this to take effect!)
				'''
		}

		healing: {
			Label: Healing multiplier
			Tooltip:
				'''
				Healing multiplier for healing spells
				A value of 0 means it will only heal 1 life
				(World restart required for this to take effect!)
				'''
		}
	}
}
