Items: {
	Backbone: {
		DisplayName: Backbone
		Tooltip:
			'''
			Shoots blobs made of boney flesh
			Each blob does something different
			"Grow a spine, will ya?"
			'''
	}

	BigBrother: {
		DisplayName: Big Brother
		Tooltip:
			'''
			Ignores 20 points of defense
			Swing a powerful flesh hammer that bites enemies and spawn homing soul essences that heal both allies and the user
			Grows hungrier the longer it doesn't bite anything, increasing its damage up to 600% and is reset on hit
			The hammer is thrown every third attack and seeks targets when hungry
			"Down with big brother..."
			'''
	}

	BloomRazor: {
		DisplayName: Bloom Razor
		Tooltip:
			'''
			Throw a razor-sharp flower that bounces between enemies
			Critical strikes causes the flower to shred hit targets
			'''
	}

	CandleCove: {
		DisplayName: Candle Cove
		Tooltip:
			'''
			Every now and then, a strange whirlpool appears near you
			Throwing throwing weapons into the hole will fill it up
			Once filled up, the whirlpool will collapse and a storm will occur
			The storm is independent of weather and deals damage to enemies
			After the storm, whirlpools will not spawn for 15 seconds
			'''
	}

	Colonoschord: {
		DisplayName: Colonoschord
		Tooltip:
			'''
			Ignores 40 points of defense
			Hold out a flesh harpischord that plays itself, shooting out tapeworms that bounce and pierce
			Tapeworms can hit the same enemy multiple times
			"Go Go Gadget, Colonoscopy!"
			'''
	}

	CursedCassette: {
		DisplayName: Cursed Cassette
		Tooltip:
			'''
			Upon running out of inspiration, a dark spirit spawns on top of you
			The spirit will shoot cursed notes at enemies that bounce around
			The spirit will shoot faster the higher your inspiration regeneration
			Cursed notes are affected by wind and string instrument bonuses
			'''
	}

	Dandelizer: {
		DisplayName: Dandelizer
		Tooltip:
			'''
			Swings a flowery mace that releases lingering healing flowers on its first hit
			Up to 4 healing flowers can exist at once
			"That's not even the right flower!"
			'''
	}

	ForbiddenCrucifix: {
		DisplayName: Forbidden Crucifix
		Tooltip:
			'''
			Charge up a spooky beam of light
			The longer the charge, the bigger the beam
			"You're a fool! All my ancestors wer-"
			'''
	}

	FacundoYPanfilo: {
		DisplayName: Panfilo & Facundo
		Tooltip:
			'''
			Throw two sentient twin heads that latch onto enemies
			When one head is latched, it will drag the other
			Each head will chew on the target 7 times before disappearing
			"¡Es tremenda lucha!"
			'''
	}

	FiestaGarments: {
		DisplayName: Fiesta Garments
		Tooltip:
			'''
			15% increased symphonic and radiant damage
			Healing spells will heal an additional 3 life
			Enemies are less likely to target you
			'''
	}

	FiestaMaskara: {
		DisplayName: Fiesta Maskara
		Tooltip:
			'''
			10% increased healing and symphonic playing speed
			5% increased inspiration regeneration rate
			Enemies are less likely to target you
			'''
		SetBonus:
			'''
			Dealing symphonic or radiant damage builds a special meter
			When the meter is full, press 'Armor Ability' key to unleash a cloud of notes
			The notes deal damage to enemies and heal ally life equivalent to heal bonus
			'''
	}

	FiestaPantaloons: {
		DisplayName: Fiesta Pantaloons
		Tooltip:
			'''
			15% increased movement speed
			Increases the duration of your symphonic empowerments by 2 seconds
			Enemies are less likely to target you
			'''
	}

	GastricJuices: {
		DisplayName: Gastric Juices
		Tooltip:
			'''
			Throw a sentient stomach that vomits everwhere on impact, inflicting Ulcer which increases damage taken by 5
			If the vomit miss, they will land on the ground and form puddles which can be picked up by players
			Puddles grant Acid Reflux buff when picked up, which increases damage by 5% and armor penetration by 5
			Puddles also heal allies but does not trigger on-heal effects
			'''
	}

	GoreEarVisor: {
		DisplayName: Gore Visor
		Tooltip:
			'''
			10% increased symphonic damage
			20% increased healing and symphonic playing speed
			15% increased inspiration regeneration rate
			Enemies are less likely to target you
			"I'm all ears"
			'''
		SetBonus:
			'''
			Healing spells heal an additional 6 life
			Increases the duration of your symphonic empowerments by 8 seconds
			Press 'Armor Ability' key to summon a swarm of ear worms
			Ear worms home into enemies and replenish player resources at a fixed amount
			Player resources include life, mana, inspiration and exhaustion
			60 second cooldown
			'''
	}

	GoreHandVisage: {
		DisplayName: Gore Visage
		Tooltip:
			'''
			10% increased throwing and radiant casting speed
			45% increased radiant damage
			15% increased throwing damage
			Enemies are more likely to target you
			"Hehe, knucklehead"
			'''
		SetBonus:
			'''
			Increases maximum technique points by 2
			Dealing damage with tainted healer weapons heal life on critical hits
			Press 'Armor Ability' key to summon a giant hand
			The hand blocks incoming enemy projectiles but takes damage
			Upon receiving enough damage, the hand breaks and is put on cooldown
			30 second cooldown
			'''
	}

	GoreWitchHat: {
		DisplayName: Gore Hat
		Tooltip:
			'''
			10% increased symphonic damage
			20% increased healing and symphonic playing speed
			15% increased inspiration regeneration rate
			Enemies are less likely to target you
			(Old Gore Visor design)
			'''
		SetBonus:
			'''
			Healing spells heal an additional 6 life
			Increases the duration of your symphonic empowerments by 8 seconds
			Press 'Armor Ability' key to summon a swarm of mini Orro-Boro-like leeches
			Leeches home into enemies and replenish player resources at a fixed amount
			Player resources include life, mana, inspiration and exhaustion
			60 second cooldown
			'''
	}

	Gourdnade: {
		DisplayName: Gourdnade
		Tooltip:
			'''
			Flip a rotting gourd in the air that eventually falls
			Depending on how good the spin is, the gourd will land standing up
			The gourd attracts flies on successful landings, or destroyed if not
			"World's stinkiest game of Flip the Bottle..."
			'''
	}

	LarrytheLarynx: {
		DisplayName: Larry the Larynx
		Tooltip:
			'''
			Throw a vocal chord that vibrates in place on impact
			Critical strikes cause Larry to emit shockwaves
			Tunes enemies, causing them to take 10% more damage
			'''
	}

	LeakingInkPipe: {
		DisplayName: Leaking Ink Pipe
		Tooltip:
			'''
			Upon running out of inspiration, your bard weapons will leak ink
			The stream of leaking ink is affected by your held weapon's stats
			Additionally, enemies splashed by ink take increased fire damage
			"We can rebuild it"
			'''
	}

	LickguaFranca: {
		DisplayName: Lickgua Franca
		Tooltip:
			'''
			Constantly spews out saliva when played
			Successfully timing hits increases the amount of saliva spat out
			{$Mods.ThoriumMod.Common.Tooltips.BigInstrument}
			"There is always a Lickman's term"
			'''
	}

	ManlessHorseHead: {
		DisplayName: Manless Horse Head
		Tooltip:
			'''
			Screams at your general direction
			"No longer manless, but still is a horse head"
			'''
	}

	MushDrum: {
		DisplayName: Mush Drum
		Tooltip: Shoots out spores that linger
	}

	MushroomMarcherArmor: {
		DisplayName: Mushroom Marcher Armor
		Tooltip: 5% increased throwing damage
	}

	MushroomMarcherBoots: {
		DisplayName: Mushroom Marcher Boots
		Tooltip: 5% increased throwing damage
	}

	MushroomMarcherCap: {
		DisplayName: Mushroom Marcher Cap
		Tooltip: 5% increased throwing damage
		SetBonus:
			'''
			Increases maximum technique points by 1
			Using your technique throws a barrage of spore grenades
			'''
	}

	NerveEndings: {
		DisplayName: Nerve Endings
		Tooltip:
			'''
			Hold <left> to charge a sticky, flesh javelin
			Leaves behind fangs when thrown while charged, homing to enemies struck by the javelin
			"Designed to hit the most sensitive nerve endings, maximizing pain" 
			'''
	}

	OldWoodBaton: {
		DisplayName: Old Wood Baton
		Tooltip: '''"Doubles as a walking stick"'''
	}

	OldWoodWhistle: {
		DisplayName: Old Wood Whistle
		Tooltip: '''"Great for scaring away trick or treaters!"'''
	}

	Olfactor: {
		DisplayName: Olfactor
		Tooltip: Shoots snot at nearby enemies
	}

	OmenoftheDamned: {
		DisplayName: Omen of the Damned
		Tooltip:
			'''
			Hold down to pull back the slingshot, then release to fling ammo
			Converts mossy pebbles into a barrage of the angry souls of the damned
			Shoots more souls the further the weapon is pulled back
			'If you believe your weapon can cause mass extinction, then so it will'
			'''
	}

	Orriata: {
		DisplayName: Orriata
		Tooltip:
			'''
			Throw a fast moving eyeball that explodes on impact
			"Eye for an eye, makes the whole world blind..."
			'''
	}

	PinkyCross: {
		DisplayName: Pinky Cross
		Tooltip:
			'''
			Ignores 10 points of defense
			Channel a cross made of flesh that smites enemies, increasing life regeneration per enemy
			Deals more damage against non-segmented bosses
			*Unstubs your toe*
			'''
	}

	PotofPain: {
		DisplayName: Pot of Pain
		Tooltip: Throw a pot that grows thorns as it falls down
	}

	Pumpkaracas: {
		DisplayName: Pumpkaracas
		Tooltip: Shake two pumpkin maracas that attract flies
	}

	RotGuard: {
		DisplayName: Rot Guard
		Tooltip:
			'''
			Shoots a small, bouncy gourd that heals allies
			Allies healed gain 5 defense for 10 seconds
			"Yummy!"
			'''
	}

	Sceyethe: {
		DisplayName: Sceyethe
		Tooltip:
			'''
			<left> to swing this scythe directionally
			<right> to spin the scythe instead
			Swinging the scythe shoots a short-ranged barrage of eyes
			Spinning the scythe releases slow eyes that home in
			"Truly a scythe to behold, get it?"
			'''
	}

	Sclerinet: {
		DisplayName: Sclerinet
		Tooltip:
			'''
			Shoots three vitreous bubbles that home into enemies
			Dealing damage with Subclavian Trumpet empowers this weapon
			While empowered, this instrument uses up no inspiration and improves homing
			"Solitude in Eye Minor"
			'''
	}

	ScreamWhistle: {
		DisplayName: Scream Whistle
		Tooltip:
			'''
			Shoots an assortment of bones that vary in sizes, which build a special meter on hit
			When the meter is full, <right> to perform an ear-shattering death whistle
			Activating the death whistle empowers this weapon, giving bones aggressive homing
			'''
	}

	SecretPainting: {
		DisplayName: I Made This Just For You!
		Tooltip:
			'''
			By EduaRRdo
			For DylanDoe21
			'''
	}

	SneezePriestGreaves: {
		DisplayName: Sneeze Priest Greaves
		Tooltip:
			'''
			5% increased radiant damage
			15% decreased non-radiant damage
			Healing spells heal an additional life
			"Bless You!"
			'''
	}

	SneezePriestNose: {
		DisplayName: Sneeze Priest Nose
		Tooltip:
			'''
			10% increased radiant damage
			15% decreased non-radiant damage
			Healing spells heal an additional life
			"Bless You!"
			'''
		SetBonus:
			'''
			Healing spells heal an additional life
			Gaining Soul Essence causes the user to sneeze violently
			Sneezing grants short invincibility frames and shoots a barrage of snot
			'''
	}

	SneezePriestRobe: {
		DisplayName: Sneeze Priest Robe
		Tooltip:
			'''
			15% increased radiant damage
			15% decreased non-radiant damage
			Healing spells heal an additional 3 life
			"Bless You!"
			'''
	}

	Sneezoo: {
		DisplayName: Sneezoo
		Tooltip:
			'''
			Shoots two clumps of snot at once
			"HA.. HA- HAAAACHOOOO!"
			'''
	}

	SongFlower: {
		DisplayName: Song Flower
		Tooltip:
			'''
			Shoots seeds that bloom into Song Flowers which shoot enemies
			Song Flowers deal reduced damage if multiple are spawned in a short period of time
			"There are zombies in your lawn"
			'''
	}

	SubclavianTrumpet: {
		DisplayName: Subclavian Trumpet
		Tooltip:
			'''
			Shoots a swirling tangle of arteries and veins
			Dealing damage with Sclerinet empowers this weapon
			While empowered, this instrument uses up no inspiration and deal 50% more damage
			"Quite unnerving..."
			'''
	}

	TendrilRoseSanguine: {
		DisplayName: Tendril Rose Sanguine
		Tooltip:
			'''
			Shoot out a thorn that hits enemies multiple times
			Thorns stay attached to the player
			'''
	}

	TerrariumParticleAccelerator: {
		DisplayName: Terrarium Particle Accelerator
		Tooltip:
			'''
			Hold down to pull back the slingshot, then release to fling ammo
			Converts mossy pebbles into hyper-accelerated particles that split on impact
			'''
	}

	TheWitchAuthor: {
		DisplayName: The Witch Author
		Tooltip: By Not Una Nancy Owen (n0t_UN_Owen)
	}

	ToothRusher: {
		DisplayName: Tooth Rusher
		Tooltip:
			'''
			Ignores 10 points of defense
			Throw a heavy flesh tomawahk, which will slow down and spin if it misses
			After spinning for a while, it will rapidly rush the nearest enemy
			"Brush your teeth or get rushed by 'em!" 
			'''
	}

	VerbalFire: {
		DisplayName: Verbal Fire
		Tooltip:
			'''
			Continuously shoots "swear" words at enemies
			Successfully timing increases fire rate and projectiles shot
			Fire rate bonus stacks with attack speed empowerment
			{$Mods.ThoriumMod.Common.Tooltips.BigInstrument}
			"Woah, watch your language!"
			'''
	}
}

