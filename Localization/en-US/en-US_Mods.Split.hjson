		DisplayName: Beloved Tomboyish Staff
		Tooltip: Summons a beloved tomboyish ice fairy to fight for you
	}

	Wildfire: {
		SoundofFire: {
			Title: Sound of Fire
			Description: Obtained while attacking enemies normally. When super bar is full, right click to cast [c/ffb000:song of flame].
		}

		SongofFlame: {
			Title: Song of Flame
			Description: Attacks have shorter cooldown and recover inspiration on hit.
		}
	}

	CarmenMortis: {
		SecondWind: {
			DisplayName: Second Wind
			Tooltip: While [fx/eb:Ethereal Bond] is active, stop attacking to automatically charge up a powerful shockwave, attacking again or switching weapons will cancel the charge but will not consume [fx/eb:Ethereal Bond]. The shockwave will heal 200 health of the user and allies within empowerment, as well as creating an explosion of rapid homing skulls.
		}
	}

