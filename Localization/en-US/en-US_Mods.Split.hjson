			Description: Hold attack to throw a burst of three hammers. Upon throwing three sets of bursts, release attack to throw the [c/ffb000:Mallet of Jurisdiction].
		}

		BigHammer: {
			Title: Mallet of Jurisdiction
			Description: Throw a large hammer that is shot at your cursor after a while, exploding on hit.
		}
	}

	DemonBloodSword.DisplayName: Kee-Oth

